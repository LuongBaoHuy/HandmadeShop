@model doan1.Models.Voucher

@{
    ViewData["Title"] = "Chi tiết voucher";
}

<style>
    /* Import Google Fonts */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    /* CSS Variables */
    :root {
        --primary-blue: #0066cc;
        --secondary-blue: #4da6ff;
        --light-blue: #e6f3ff;
        --dark-blue: #004499;
        --ocean-blue: #1e88e5;
        --sky-blue: #42a5f5;
        
        --white: #ffffff;
        --light-gray: #f8f9fa;
        --medium-gray: #e9ecef;
        --dark-gray: #495057;
        --text-primary: #2c3e50;
        --text-secondary: #6c757d;
        
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --info: #3b82f6;
        
        --shadow-light: 0 8px 32px rgba(31, 38, 135, 0.1);
        --shadow-medium: 0 12px 40px rgba(31, 38, 135, 0.15);
        --shadow-strong: 0 16px 48px rgba(31, 38, 135, 0.2);
        --shadow-neumorphism: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;
        
        --gradient-primary: linear-gradient(135deg, var(--primary-blue) 0%, var(--ocean-blue) 100%);
        --gradient-secondary: linear-gradient(135deg, var(--secondary-blue) 0%, var(--sky-blue) 100%);
        --gradient-light: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
    }

    /* Global Styles */
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        color: var(--text-primary);
        margin: 0;
        padding: 0;
    }

    .voucher-container {
        padding: 2rem 1rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Glass Card */
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        box-shadow: var(--shadow-neumorphism);
        border: 1px solid rgba(255, 255, 255, 0.3);
        overflow: hidden;
        margin-bottom: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-strong);
    }

    .glass-header {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        padding: 2.5rem;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        position: relative;
    }

    .glass-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--gradient-primary);
        opacity: 0.1;
    }

    .glass-title {
        position: relative;
        z-index: 1;
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .glass-title i {
        color: var(--primary-blue);
        -webkit-text-fill-color: var(--primary-blue);
    }

    .glass-content {
        padding: 2.5rem;
    }

    /* Info Display */
    .info-section {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: var(--shadow-light);
    }

    .section-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-row:hover {
        background: rgba(255, 255, 255, 0.3);
        margin: 0 -1rem;
        padding: 1rem;
        border-radius: 12px;
    }

    .info-label {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.95rem;
        min-width: 200px;
    }

    .info-value {
        font-weight: 500;
        color: var(--text-secondary);
        font-size: 0.95rem;
        text-align: right;
        flex: 1;
    }

    /* Glass Badge */
    .glass-badge {
        padding: 0.4rem 1rem;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: 500;
        box-shadow: var(--shadow-light);
        display: inline-block;
    }

    .glass-badge.success {
        background: linear-gradient(135deg, var(--success) 0%, #34d399 100%);
        color: white;
    }

    .glass-badge.danger {
        background: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
        color: white;
    }

    .glass-badge.warning {
        background: linear-gradient(135deg, var(--warning) 0%, #fbbf24 100%);
        color: white;
    }

    .glass-badge.info {
        background: linear-gradient(135deg, var(--info) 0%, #60a5fa 100%);
        color: white;
    }

    .glass-badge.primary {
        background: var(--gradient-primary);
        color: white;
    }

    .voucher-code {
        background: rgba(0, 102, 204, 0.1);
        border: 1px solid rgba(0, 102, 204, 0.3);
        border-radius: 8px;
        padding: 0.4rem 0.8rem;
        font-family: 'Courier New', monospace;
        font-weight: 600;
        color: var(--primary-blue);
        font-size: 0.9rem;
        display: inline-block;
    }

    .discount-value {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--primary-blue);
    }

    /* Glass Buttons */
    .glass-btn {
        background: var(--gradient-primary);
        border: none;
        border-radius: 15px;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .glass-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--gradient-secondary);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .glass-btn:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        color: white;
        text-decoration: none;
    }

    .glass-btn:hover::before {
        opacity: 1;
    }

    .glass-btn-secondary {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 15px;
        color: var(--text-primary);
        padding: 0.8rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
    }

    .glass-btn-secondary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        background: rgba(255, 255, 255, 0.9);
        color: var(--text-primary);
        text-decoration: none;
    }

    .glass-btn-warning {
        background: linear-gradient(135deg, var(--warning) 0%, #fbbf24 100%);
        border: none;
        border-radius: 15px;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .glass-btn-warning::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .glass-btn-warning:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        color: white;
        text-decoration: none;
    }

    .glass-btn-warning:hover::before {
        opacity: 1;
    }

    .glass-btn-danger {
        background: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
        border: none;
        border-radius: 15px;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .glass-btn-danger::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .glass-btn-danger:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        color: white;
        text-decoration: none;
    }

    .glass-btn-danger:hover::before {
        opacity: 1;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.3);
    }

    .button-group .right-buttons {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    /* Table for usage history */
    .glass-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    .glass-table th {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 2px solid rgba(255, 255, 255, 0.3);
        font-size: 0.9rem;
    }

    .glass-table td {
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        vertical-align: middle;
    }

    .glass-table tbody tr {
        transition: all 0.3s ease;
    }

    .glass-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
        box-shadow: var(--shadow-light);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .voucher-container {
            padding: 1rem 0.5rem;
        }
        
        .glass-header {
            padding: 2rem;
        }
        
        .glass-title {
            font-size: 2rem;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .glass-content {
            padding: 2rem;
        }
        
        .info-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
        
        .info-label {
            min-width: auto;
        }
        
        .info-value {
            text-align: left;
        }
        
        .button-group {
            flex-direction: column;
            gap: 1rem;
        }
        
        .button-group .right-buttons {
            flex-direction: column;
            width: 100%;
            gap: 1rem;
        }
        
        .glass-btn, .glass-btn-secondary, .glass-btn-warning, .glass-btn-danger {
            width: 100%;
            justify-content: center;
        }
        
        .glass-table {
            font-size: 0.8rem;
        }
        
        .glass-table th,
        .glass-table td {
            padding: 0.75rem 0.5rem;
        }
    }
</style>

<div class="voucher-container">
    <!-- Header Section -->
    <div class="glass-card">
        <div class="glass-header">
            <h1 class="glass-title">
                <i class="fas fa-tag"></i>
                Chi tiết voucher
            </h1>
        </div>

        <!-- Content Section -->
        <div class="glass-content">
            <div class="row">
                <div class="col-lg-6">
                    <!-- Voucher Information -->
                    <div class="info-section">
                        <div class="section-title">
                            <i class="fas fa-info-circle"></i>
                            Thông tin voucher
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">ID:</div>
                            <div class="info-value">@Html.DisplayFor(model => model.Id)</div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Mã voucher:</div>
                            <div class="info-value">
                                <span class="voucher-code">@Html.DisplayFor(model => model.Code)</span>
                            </div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Loại giảm giá:</div>
                            <div class="info-value">
                                @if (Model?.DiscountType == "percent")
                                {
                                    <span class="glass-badge info">Phần trăm</span>
                                }
                                else
                                {
                                    <span class="glass-badge warning">Số tiền cố định</span>
                                }
                            </div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Giá trị giảm:</div>
                            <div class="info-value">
                                @if (Model?.DiscountType == "percent")
                                {
                                    <span class="discount-value">@(Model?.DiscountValue ?? 0)%</span>
                                }
                                else
                                {
                                    <span class="discount-value">@((Model?.DiscountValue ?? 0).ToString("C", new System.Globalization.CultureInfo("vi-VN")))</span>
                                }
                            </div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Đơn hàng tối thiểu:</div>
                            <div class="info-value">
                                @if (Model?.MinOrderValue != null && Model.MinOrderValue > 0)
                                {
                                    <span style="font-weight: 600;">@Model.MinOrderValue.Value.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">Không yêu cầu</span>
                                }
                            </div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Ngày hết hạn:</div>
                            <div class="info-value">
                                @if (Model?.ExpiryDate != null)
                                {
                                    var today = DateOnly.FromDateTime(DateTime.Now);
                                    var isExpired = Model.ExpiryDate.Value < today;
                                    <div>
                                        <div style="color: @(isExpired ? "var(--danger)" : "var(--success)"); font-weight: 600;">
                                            @Model.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                        </div>
                                        @if (isExpired)
                                        {
                                            <span class="glass-badge danger">Đã hết hạn</span>
                                        }
                                        else
                                        {
                                            <span class="glass-badge success">Còn hiệu lực</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">Không giới hạn</span>
                                }
                            </div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Trạng thái:</div>
                            <div class="info-value">
                                @if (Model?.IsActive == true)
                                {
                                    <span class="glass-badge success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="glass-badge danger">Vô hiệu hóa</span>
                                }
                            </div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Đã sử dụng:</div>
                            <div class="info-value">
                                <span class="glass-badge primary">@(Model?.Orders?.Count ?? 0) lần</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-6">
                    <!-- Usage History -->
                    <div class="info-section">
                        <div class="section-title">
                            <i class="fas fa-shopping-cart"></i>
                            Lịch sử sử dụng
                        </div>
                        
                        @if (Model?.Orders != null && Model.Orders.Any())
                        {
                            <div style="overflow-x: auto;">
                                <table class="glass-table">
                                    <thead>
                                        <tr>
                                            <th>Đơn hàng</th>
                                            <th>Khách hàng</th>
                                            <th>Tổng tiền</th>
                                            <th>Ngày tạo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" 
                                                       style="color: var(--primary-blue); text-decoration: none; font-weight: 600;">
                                                        #@order.Id
                                                    </a>
                                                </td>
                                                <td>@order.User?.Username</td>
                                                <td>
                                                    <span style="color: var(--success); font-weight: 600;">
                                                        @order.TotalPrice.ToString("C", new System.Globalization.CultureInfo("vi-VN"))
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (order.CreatedAt.HasValue)
                                                    {
                                                        @order.CreatedAt.Value.ToString("dd/MM/yyyy")
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div style="text-align: center; padding: 3rem; color: var(--text-secondary);">
                                <i class="fas fa-shopping-cart" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                                <p>Voucher này chưa được sử dụng</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="button-group">
                <a asp-action="Index" class="glass-btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
                <div class="right-buttons">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="glass-btn-warning">
                        <i class="fas fa-edit"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model?.Id" class="glass-btn-danger">
                        <i class="fas fa-trash"></i> Xóa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
