@model doan1.Models.Voucher

@{
    ViewData["Title"] = "Xóa voucher";
}

<style>
    /* Import Google Fonts */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    /* CSS Variables */
    :root {
        --primary-blue: #0066cc;
        --secondary-blue: #4da6ff;
        --light-blue: #e6f3ff;
        --dark-blue: #004499;
        --ocean-blue: #1e88e5;
        --sky-blue: #42a5f5;
        
        --white: #ffffff;
        --light-gray: #f8f9fa;
        --medium-gray: #e9ecef;
        --dark-gray: #495057;
        --text-primary: #2c3e50;
        --text-secondary: #6c757d;
        
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --info: #3b82f6;
        
        --shadow-light: 0 8px 32px rgba(31, 38, 135, 0.1);
        --shadow-medium: 0 12px 40px rgba(31, 38, 135, 0.15);
        --shadow-strong: 0 16px 48px rgba(31, 38, 135, 0.2);
        --shadow-neumorphism: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;
        
        --gradient-primary: linear-gradient(135deg, var(--primary-blue) 0%, var(--ocean-blue) 100%);
        --gradient-secondary: linear-gradient(135deg, var(--secondary-blue) 0%, var(--sky-blue) 100%);
        --gradient-light: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
        --gradient-danger: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
    }

    /* Global Styles */
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        color: var(--text-primary);
        margin: 0;
        padding: 0;
    }

    .voucher-container {
        padding: 2rem 1rem;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Glass Card */
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        box-shadow: var(--shadow-neumorphism);
        border: 1px solid rgba(255, 255, 255, 0.3);
        overflow: hidden;
        margin-bottom: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-strong);
    }

    .glass-header {
        background: var(--gradient-danger);
        padding: 2.5rem;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        position: relative;
    }

    .glass-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: white;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    .glass-content {
        padding: 2.5rem;
    }

    /* Warning Box */
    .warning-box {
        background: rgba(239, 68, 68, 0.1);
        border: 2px solid rgba(239, 68, 68, 0.3);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        text-align: center;
        box-shadow: var(--shadow-light);
    }

    .warning-icon {
        font-size: 3rem;
        color: var(--danger);
        margin-bottom: 1rem;
        display: block;
    }

    .warning-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--danger);
        margin-bottom: 0.5rem;
    }

    .warning-message {
        font-size: 1rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    /* Info Section */
    .info-section {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: var(--shadow-light);
    }

    .section-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-row:hover {
        background: rgba(255, 255, 255, 0.3);
        margin: 0 -1rem;
        padding: 1rem;
        border-radius: 12px;
    }

    .info-label {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.95rem;
        min-width: 150px;
    }

    .info-value {
        font-weight: 500;
        color: var(--text-secondary);
        font-size: 0.95rem;
        text-align: right;
        flex: 1;
    }

    /* Glass Badge */
    .glass-badge {
        padding: 0.4rem 1rem;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: 500;
        box-shadow: var(--shadow-light);
        display: inline-block;
    }

    .glass-badge.success {
        background: linear-gradient(135deg, var(--success) 0%, #34d399 100%);
        color: white;
    }

    .glass-badge.danger {
        background: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
        color: white;
    }

    .glass-badge.warning {
        background: linear-gradient(135deg, var(--warning) 0%, #fbbf24 100%);
        color: white;
    }

    .glass-badge.info {
        background: linear-gradient(135deg, var(--info) 0%, #60a5fa 100%);
        color: white;
    }

    .glass-badge.primary {
        background: var(--gradient-primary);
        color: white;
    }

    .voucher-code {
        background: rgba(0, 102, 204, 0.1);
        border: 1px solid rgba(0, 102, 204, 0.3);
        border-radius: 8px;
        padding: 0.4rem 0.8rem;
        font-family: 'Courier New', monospace;
        font-weight: 600;
        color: var(--primary-blue);
        font-size: 0.9rem;
        display: inline-block;
    }

    .discount-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
    }

    /* Glass Buttons */
    .glass-btn {
        background: var(--gradient-primary);
        border: none;
        border-radius: 15px;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .glass-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--gradient-secondary);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .glass-btn:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        color: white;
        text-decoration: none;
    }

    .glass-btn:hover::before {
        opacity: 1;
    }

    .glass-btn-secondary {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 15px;
        color: var(--text-primary);
        padding: 0.8rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
    }

    .glass-btn-secondary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        background: rgba(255, 255, 255, 0.9);
        color: var(--text-primary);
        text-decoration: none;
    }

    .glass-btn-danger {
        background: var(--gradient-danger);
        color: white;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .voucher-container {
            padding: 1rem 0.5rem;
        }
        
        .glass-header {
            padding: 2rem;
        }
        
        .glass-title {
            font-size: 2rem;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .glass-content {
            padding: 2rem;
        }
        
        .info-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
        
        .info-label {
            min-width: auto;
        }
        
        .info-value {
            text-align: left;
        }
        
        .button-group {
            flex-direction: column;
            gap: 1rem;
        }
        
        .glass-btn, .glass-btn-secondary, .glass-btn-danger {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="voucher-container">
    <!-- Header Section -->
    <div class="glass-card">
        <div class="glass-header">
            <h1 class="glass-title">
                <i class="fas fa-exclamation-triangle"></i>
                Xác nhận xóa voucher
            </h1>
        </div>

        <!-- Content Section -->
        <div class="glass-content">
            <!-- Warning Message -->
            <div class="warning-box">
                <i class="fas fa-exclamation-triangle warning-icon"></i>
                <div class="warning-title">Cảnh báo!</div>
                <div class="warning-message">
                    Bạn có chắc chắn muốn xóa voucher này không?<br>
                    Hành động này không thể hoàn tác.
                </div>
            </div>
            
            <!-- Voucher Information -->
            <div class="info-section">
                <div class="section-title">
                    <i class="fas fa-info-circle"></i>
                    Thông tin voucher sẽ bị xóa
                </div>
                
                <div class="info-row">
                    <div class="info-label">Mã voucher:</div>
                    <div class="info-value">
                        <span class="voucher-code">@Html.DisplayFor(model => model.Code)</span>
                    </div>
                </div>
                
                <div class="info-row">
                    <div class="info-label">Loại giảm giá:</div>
                    <div class="info-value">
                        @if (Model?.DiscountType == "percent")
                        {
                            <span class="glass-badge info">Phần trăm</span>
                        }
                        else
                        {
                            <span class="glass-badge warning">Số tiền cố định</span>
                        }
                    </div>
                </div>
                
                <div class="info-row">
                    <div class="info-label">Giá trị giảm:</div>
                    <div class="info-value">
                        @if (Model?.DiscountType == "percent")
                        {
                            <span class="discount-value">@(Model?.DiscountValue ?? 0)%</span>
                        }
                        else
                        {
                            <span class="discount-value">@((Model?.DiscountValue ?? 0).ToString("C", new System.Globalization.CultureInfo("vi-VN")))</span>
                        }
                    </div>
                </div>
                
                <div class="info-row">
                    <div class="info-label">Trạng thái:</div>
                    <div class="info-value">
                        @if (Model?.IsActive == true)
                        {
                            <span class="glass-badge success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="glass-badge danger">Vô hiệu hóa</span>
                        }
                    </div>
                </div>
                
                <div class="info-row">
                    <div class="info-label">Đã sử dụng:</div>
                    <div class="info-value">
                        <span class="glass-badge primary">@(Model?.Orders?.Count ?? 0) lần</span>
                    </div>
                </div>
            </div>

            <!-- Additional Warning for Used Vouchers -->
            @if (Model?.Orders != null && Model.Orders.Any())
            {
                <div class="warning-box" style="background: rgba(255, 152, 0, 0.1); border-color: rgba(255, 152, 0, 0.3);">
                    <i class="fas fa-exclamation-triangle" style="color: var(--warning); font-size: 2rem; margin-bottom: 1rem;"></i>
                    <div class="warning-title" style="color: var(--warning);">Lưu ý quan trọng!</div>
                    <div class="warning-message">
                        Voucher này đã được sử dụng trong @Model.Orders.Count đơn hàng. 
                        Việc xóa có thể ảnh hưởng đến dữ liệu lịch sử đơn hàng.
                    </div>
                </div>
            }

            <!-- Form and Buttons -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="button-group">
                    <a asp-action="Index" class="glass-btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                    <button type="submit" class="glass-btn glass-btn-danger">
                        <i class="fas fa-trash"></i> Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
