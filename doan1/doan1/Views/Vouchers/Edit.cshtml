@model doan1.Models.Voucher

@{
    ViewData["Title"] = "Chỉnh sửa voucher";
}

<style>
    /* Import Google Fonts */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    /* CSS Variables */
    :root {
        --primary-blue: #0066cc;
        --secondary-blue: #4da6ff;
        --light-blue: #e6f3ff;
        --dark-blue: #004499;
        --ocean-blue: #1e88e5;
        --sky-blue: #42a5f5;
        
        --white: #ffffff;
        --light-gray: #f8f9fa;
        --medium-gray: #e9ecef;
        --dark-gray: #495057;
        --text-primary: #2c3e50;
        --text-secondary: #6c757d;
        
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --info: #3b82f6;
        
        --shadow-light: 0 8px 32px rgba(31, 38, 135, 0.1);
        --shadow-medium: 0 12px 40px rgba(31, 38, 135, 0.15);
        --shadow-strong: 0 16px 48px rgba(31, 38, 135, 0.2);
        --shadow-neumorphism: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;
        
        --gradient-primary: linear-gradient(135deg, var(--primary-blue) 0%, var(--ocean-blue) 100%);
        --gradient-secondary: linear-gradient(135deg, var(--secondary-blue) 0%, var(--sky-blue) 100%);
        --gradient-light: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
    }

    /* Global Styles */
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        color: var(--text-primary);
        margin: 0;
        padding: 0;
    }

    .voucher-container {
        padding: 2rem 1rem;
        max-width: 900px;
        margin: 0 auto;
    }

    /* Glass Card */
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        box-shadow: var(--shadow-neumorphism);
        border: 1px solid rgba(255, 255, 255, 0.3);
        overflow: hidden;
        margin-bottom: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-strong);
    }

    .glass-header {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        padding: 2.5rem;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        position: relative;
    }

    .glass-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--gradient-primary);
        opacity: 0.1;
    }

    .glass-title {
        position: relative;
        z-index: 1;
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .glass-title i {
        color: var(--primary-blue);
        -webkit-text-fill-color: var(--primary-blue);
    }

    .glass-form-container {
        padding: 2.5rem;
    }

    /* Form Styles */
    .form-group {
        margin-bottom: 1.5rem;
    }

    .glass-label {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .glass-input, .glass-select {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        padding: 0.8rem 1rem;
        width: 100%;
        color: var(--text-primary);
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-light);
    }

    .glass-input:focus, .glass-select:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1), var(--shadow-medium);
        background: rgba(255, 255, 255, 0.9);
        transform: translateY(-2px);
    }

    .glass-input::placeholder {
        color: var(--text-secondary);
    }

    /* Glass Buttons */
    .glass-btn {
        background: var(--gradient-primary);
        border: none;
        border-radius: 15px;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .glass-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--gradient-secondary);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .glass-btn:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        color: white;
        text-decoration: none;
    }

    .glass-btn:hover::before {
        opacity: 1;
    }

    .glass-btn-secondary {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 15px;
        color: var(--text-primary);
        padding: 0.8rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
    }

    .glass-btn-secondary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        background: rgba(255, 255, 255, 0.9);
        color: var(--text-primary);
        text-decoration: none;
    }

    .glass-btn-warning {
        background: linear-gradient(135deg, var(--warning) 0%, #fbbf24 100%);
        border: none;
        border-radius: 15px;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-light);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .glass-btn-warning::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .glass-btn-warning:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-medium);
        color: white;
        text-decoration: none;
    }

    .glass-btn-warning:hover::before {
        opacity: 1;
    }

    /* Validation Styles */
    .glass-validation-summary {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        color: var(--danger);
        font-weight: 500;
    }

    .text-danger {
        color: var(--danger) !important;
        font-weight: 500;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .glass-form-text {
        color: var(--text-secondary);
        font-size: 0.85rem;
        margin-top: 0.25rem;
        font-style: italic;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.3);
    }

    .button-group .right-buttons {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .voucher-container {
            padding: 1rem 0.5rem;
        }
        
        .glass-header {
            padding: 2rem;
        }
        
        .glass-title {
            font-size: 2rem;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .glass-form-container {
            padding: 2rem;
        }
        
        .button-group {
            flex-direction: column;
            gap: 1rem;
        }
        
        .button-group .right-buttons {
            flex-direction: column;
            width: 100%;
            gap: 1rem;
        }
        
        .glass-btn, .glass-btn-secondary, .glass-btn-warning {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="voucher-container">
    <!-- Header Section -->
    <div class="glass-card">
        <div class="glass-header">
            <h1 class="glass-title">
                <i class="fas fa-edit"></i>
                Chỉnh sửa voucher
            </h1>
        </div>

        <!-- Form Container -->
        <div class="glass-form-container">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="glass-validation-summary"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Code" class="glass-label">Mã voucher</label>
                            <input asp-for="Code" class="glass-input" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="DiscountType" class="glass-label">Loại giảm giá</label>
                            <select asp-for="DiscountType" class="glass-select" onchange="updateDiscountLabel()">
                                <option value="percent">Phần trăm (%)</option>
                                <option value="amount">Số tiền cố định</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="DiscountValue" class="glass-label" id="discountLabel">Giá trị giảm</label>
                            <input asp-for="DiscountValue" type="number" step="0.01" class="glass-input" />
                            <span asp-validation-for="DiscountValue" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MinOrderValue" class="glass-label">Giá trị đơn hàng tối thiểu</label>
                            <input asp-for="MinOrderValue" type="number" step="0.01" class="glass-input" />
                            <span asp-validation-for="MinOrderValue" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ExpiryDate" class="glass-label">Ngày hết hạn</label>
                            <input asp-for="ExpiryDate" type="datetime-local" class="glass-input" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            <small class="glass-form-text">Để trống nếu không có ngày hết hạn</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="IsActive" class="glass-label">Trạng thái</label>
                            <select asp-for="IsActive" class="glass-select">
                                <option value="true">Hoạt động</option>
                                <option value="false">Vô hiệu hóa</option>
                            </select>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="button-group">
                    <a asp-action="Index" class="glass-btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                    <div class="right-buttons">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="glass-btn-warning">
                            <i class="fas fa-eye"></i> Chi tiết
                        </a>
                        <button type="submit" class="glass-btn">
                            <i class="fas fa-save"></i> Cập nhật
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function updateDiscountLabel() {
            const discountType = document.getElementById('DiscountType').value;
            const label = document.getElementById('discountLabel');
            
            if (discountType === 'percent') {
                label.textContent = 'Giá trị giảm (%)';
            } else {
                label.textContent = 'Giá trị giảm (VNĐ)';
            }
        }
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateDiscountLabel();
        });
    </script>
}
