@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-ban text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="text-danger mb-3">Không có quyền truy cập</h2>
                    <p class="text-muted mb-4">
                        Bạn không có quyền truy cập vào trang này. 
                        Vui lòng liên hệ quản trị viên để được hỗ trợ.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="@Url.Action("Login", "Auth")" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập lại
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                            <i class="fas fa-home me-2"></i>Trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
