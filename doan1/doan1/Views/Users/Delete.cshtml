@model doan1.Models.User

@{
    ViewData["Title"] = "Xóa người dùng";
}

<div class="users-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon danger">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h1>Xác nhận xóa người dùng</h1>
                <p>Bạn đang thực hiện thao tác xóa người dùng @Model.FullName</p>
            </div>
        </div>
    </div>

    <div class="delete-container">
        <div class="glass-card warning-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-shield-alt"></i>
                    Cảnh báo bảo mật
                </h3>
                <div class="warning-badge">
                    <i class="fas fa-exclamation-triangle"></i>
                    Cảnh báo
                </div>
            </div>
            <div class="card-body">
                <div class="warning-content">
                    <div class="warning-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="warning-text">
                        <h4>Hành động không thể hoàn tác!</h4>
                        <p>Việc xóa người dùng sẽ xóa toàn bộ dữ liệu liên quan và không thể khôi phục. Vui lòng xem xét kỹ trước khi thực hiện.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card info-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-user-times"></i>
                    Thông tin người dùng sẽ bị xóa
                </h3>
            </div>
            <div class="card-body">
                <div class="user-preview">
                    <div class="user-avatar-section">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" alt="Profile" class="user-avatar" />
                        }
                        else
                        {
                            <div class="avatar-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        }
                        <div class="user-info">
                            <h4>@Model.FullName</h4>
                            <p>@Model.Email</p>
                            @if (!string.IsNullOrEmpty(Model.Role))
                            {
                                <span class="role-badge @Model.Role.ToLower()">@Model.Role</span>
                            }
                        </div>
                    </div>
                    
                    <div class="user-details">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-hashtag"></i>
                                ID
                            </div>
                            <div class="detail-value">@Model.Id</div>
                        </div>
                        
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-user"></i>
                                Tên đăng nhập
                            </div>
                            <div class="detail-value">@Model.Username</div>
                        </div>
                        
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-envelope"></i>
                                Email
                            </div>
                            <div class="detail-value">@Model.Email</div>
                        </div>
                        
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="fas fa-id-card"></i>
                                Họ và tên
                            </div>
                            <div class="detail-value">@Model.FullName</div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-phone"></i>
                                    Số điện thoại
                                </div>
                                <div class="detail-value">@Model.Phone</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card confirm-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-check-circle"></i>
                    Xác nhận thao tác
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Delete" method="post" class="confirm-form">
                    <div class="confirm-text">
                        <p>Để xác nhận xóa người dùng <strong>@Model.FullName</strong>, vui lòng nhấn nút <strong>"Xác nhận xóa"</strong> bên dưới.</p>
                        <p class="warning-note">
                            <i class="fas fa-info-circle"></i>
                            Thao tác này sẽ xóa vĩnh viễn tài khoản và toàn bộ dữ liệu liên quan.
                        </p>
                    </div>
                    
                    <div class="form-actions">
                        <a asp-action="Index" class="glass-btn secondary large">
                            <i class="fas fa-arrow-left"></i>
                            <span>Hủy bỏ</span>
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="glass-btn info large">
                            <i class="fas fa-eye"></i>
                            <span>Xem chi tiết</span>
                        </a>
                        <button type="submit" class="glass-btn danger large" onclick="return confirmDelete()">
                            <i class="fas fa-trash"></i>
                            <span>Xác nhận xóa</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Bạn có chắc chắn muốn xóa người dùng này không?\n\nHành động này không thể hoàn tác!');
        }

        // Add warning animations
        document.addEventListener('DOMContentLoaded', function() {
            // Animate warning elements
            const warningElements = document.querySelectorAll('.warning-card, .warning-content');
            warningElements.forEach((element, index) => {
                element.style.animationDelay = `${index * 0.1}s`;
                element.classList.add('fade-in-up');
            });

            // Pulse warning icon
            const warningIcon = document.querySelector('.warning-icon i');
            if (warningIcon) {
                setInterval(() => {
                    warningIcon.style.transform = 'scale(1.1)';
                    setTimeout(() => {
                        warningIcon.style.transform = 'scale(1)';
                    }, 200);
                }, 2000);
            }
        });
    </script>
}

@section Styles {
    <style>
        /* Import Google Fonts */
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        :root {
            --primary-blue: #0066cc;
            --secondary-blue: #4da6ff;
            --light-blue: #e6f3ff;
            --dark-blue: #004499;
            --ocean-blue: #1e88e5;
            --sky-blue: #42a5f5;
            
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --medium-gray: #e9ecef;
            --dark-gray: #495057;
            --text-primary: #2c3e50;
            --text-secondary: #6c757d;
            
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            
            --shadow-light: 0 8px 32px rgba(31, 38, 135, 0.1);
            --shadow-medium: 0 12px 40px rgba(31, 38, 135, 0.15);
            --shadow-strong: 0 16px 48px rgba(31, 38, 135, 0.2);
            --shadow-neumorphism: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;
            
            --gradient-primary: linear-gradient(135deg, var(--primary-blue) 0%, var(--ocean-blue) 100%);
            --gradient-secondary: linear-gradient(135deg, var(--secondary-blue) 0%, var(--sky-blue) 100%);
            --gradient-light: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
            --gradient-danger: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            --gradient-warning: linear-gradient(135deg, var(--warning) 0%, #d97706 100%);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            color: var(--text-primary);
        }

        .users-container {
            padding: 2rem 1rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 3rem;
        }

        .header-content {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: var(--shadow-neumorphism);
            border: 1px solid rgba(255, 255, 255, 0.3);
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        .header-content::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-danger);
            opacity: 0.1;
            border-radius: 30px;
        }

        .header-title {
            position: relative;
            z-index: 1;
        }

        .title-icon {
            width: 80px;
            height: 80px;
            background: var(--gradient-primary);
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: var(--shadow-medium);
        }

        .title-icon.danger {
            background: var(--gradient-danger);
            animation: pulse 2s infinite;
        }

        .title-icon i {
            font-size: 2.5rem;
            color: white;
        }

        .header-title h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: var(--gradient-danger);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-title p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            margin: 0;
            font-weight: 400;
        }

        .delete-container {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            box-shadow: var(--shadow-neumorphism);
            border: 1px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-strong);
        }

        .glass-card .card-header {
            padding: 1.5rem 2rem;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .glass-card .card-header h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-primary);
        }

        .glass-card .card-header i {
            color: var(--primary-blue);
            font-size: 1.3rem;
        }

        .warning-card .card-header i {
            color: var(--danger);
        }

        .glass-card .card-body {
            padding: 2rem;
        }

        .warning-badge {
            background: var(--gradient-danger);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 15px;
            font-size: 0.85rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: var(--shadow-light);
            animation: pulse 2s infinite;
        }

        .warning-content {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 15px;
            padding: 1.5rem;
        }

        .warning-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient-danger);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            box-shadow: var(--shadow-medium);
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .warning-text h4 {
            color: var(--danger);
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 1.2rem;
        }

        .warning-text p {
            color: var(--text-secondary);
            margin: 0;
            line-height: 1.5;
        }

        .user-preview {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 2rem;
            align-items: start;
        }

        .user-avatar-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1rem;
        }

        .user-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: var(--shadow-medium);
        }

        .avatar-placeholder {
            width: 100px;
            height: 100px;
            background: var(--gradient-secondary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.5rem;
            box-shadow: var(--shadow-medium);
        }

        .user-info h4 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: var(--text-primary);
        }

        .user-info p {
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .user-details {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 1rem;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.3s ease;
        }

        .detail-row:hover {
            background: rgba(255, 255, 255, 0.7);
            transform: translateX(5px);
        }

        .detail-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .detail-label i {
            color: var(--primary-blue);
            width: 16px;
        }

        .detail-value {
            font-weight: 500;
            color: var(--text-primary);
        }

        .role-badge {
            padding: 0.25rem 0.6rem;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: white;
        }

        .role-badge.admin {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }

        .role-badge.customer {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }

        .role-badge.manager {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }

        .confirm-form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .confirm-text p {
            margin-bottom: 1rem;
            line-height: 1.6;
            color: var(--text-primary);
        }

        .warning-note {
            background: rgba(251, 191, 36, 0.1);
            border: 1px solid rgba(251, 191, 36, 0.2);
            border-radius: 10px;
            padding: 1rem;
            color: var(--warning);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .glass-btn {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            padding: 0.8rem 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow-light);
            position: relative;
            z-index: 1;
            overflow: hidden;
            justify-content: center;
            cursor: pointer;
        }

        .glass-btn.large {
            padding: 1rem 1.5rem;
            font-size: 1rem;
        }

        .glass-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-light);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }

        .glass-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-medium);
            text-decoration: none;
            color: var(--text-primary);
        }

        .glass-btn:hover::before {
            opacity: 1;
        }

        .glass-btn.secondary {
            background: rgba(108, 117, 125, 0.1);
            color: var(--text-secondary);
        }

        .glass-btn.info {
            background: linear-gradient(135deg, var(--info) 0%, #60a5fa 100%);
            color: white;
        }

        .glass-btn.info::before {
            background: linear-gradient(135deg, #93c5fd 0%, var(--info) 100%);
        }

        .glass-btn.danger {
            background: var(--gradient-danger);
            color: white;
        }

        .glass-btn.danger::before {
            background: linear-gradient(135deg, #f87171 0%, var(--danger) 100%);
        }

        .glass-btn.danger:hover {
            color: white;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
            100% {
                transform: scale(1);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease forwards;
        }

        @@media (max-width: 768px) {
            .users-container {
                padding: 1rem 0.5rem;
            }

            .header-content {
                padding: 2rem;
            }

            .header-title h1 {
                font-size: 2rem;
            }

            .user-preview {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                text-align: center;
            }

            .warning-content {
                flex-direction: column;
                text-align: center;
            }

            .form-actions {
                grid-template-columns: 1fr;
            }

            .detail-row {
                flex-direction: column;
                gap: 0.5rem;
                text-align: center;
            }
        }
    </style>
}
