@model doan1.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<div class="users-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="fas fa-user-edit"></i>
                </div>
                <h1>Chỉnh sửa người dùng</h1>
                <p>Cập nhật thông tin người dùng @Model.FullName</p>
            </div>
        </div>
    </div>

    <div class="form-container">
        <div class="glass-card form-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-user-edit"></i>
                    Thông tin người dùng
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit" enctype="multipart/form-data" class="glass-form">
                    <div asp-validation-summary="ModelOnly" class="glass-alert error" style="display: none;"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label asp-for="Username" class="form-label">
                                <i class="fas fa-user"></i>
                                Tên đăng nhập
                            </label>
                            <input asp-for="Username" class="glass-input readonly" readonly />
                            <span class="field-note">Tên đăng nhập không thể thay đổi</span>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-lock"></i>
                                Mật khẩu
                            </label>
                            <div class="password-container">
                                <input type="password" class="glass-input readonly" value="********" readonly />
                                <button type="button" class="glass-btn-sm warning" onclick="togglePasswordChange()" title="Đổi mật khẩu">
                                    <i class="fas fa-key"></i>
                                </button>
                            </div>
                            
                            <!-- Password Change Section -->
                            <div id="passwordChangeSection" class="password-change-section" style="display: none;">
                                <div class="password-change-header">
                                    <h4>
                                        <i class="fas fa-lock"></i>
                                        Đổi mật khẩu
                                    </h4>
                                </div>
                                <div class="password-change-body">
                                    <div class="form-group">
                                        <label for="NewPassword" class="form-label">Mật khẩu mới</label>
                                        <input type="password" name="NewPassword" id="NewPassword" class="glass-input" placeholder="Nhập mật khẩu mới..." />
                                    </div>
                                    <div class="form-group">
                                        <label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                                        <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="glass-input" placeholder="Nhập lại mật khẩu mới..." />
                                    </div>
                                    <div class="password-actions">
                                        <button type="button" class="glass-btn-sm success" onclick="savePasswordChange()">
                                            <i class="fas fa-check"></i>
                                        </button>
                                        <button type="button" class="glass-btn-sm danger" onclick="cancelPasswordChange()">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label asp-for="Email" class="form-label">
                                <i class="fas fa-envelope"></i>
                                Email
                            </label>
                            <input asp-for="Email" type="email" class="glass-input" placeholder="Nhập địa chỉ email..." />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="FullName" class="form-label">
                                <i class="fas fa-id-card"></i>
                                Họ và tên
                            </label>
                            <input asp-for="FullName" class="glass-input" placeholder="Nhập họ và tên..." />
                            <span asp-validation-for="FullName" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label asp-for="Phone" class="form-label">
                                <i class="fas fa-phone"></i>
                                Số điện thoại
                            </label>
                            <input asp-for="Phone" class="glass-input" placeholder="Nhập số điện thoại..." />
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Role" class="form-label">
                                <i class="fas fa-user-tag"></i>
                                Vai trò
                            </label>
                            <select asp-for="Role" class="glass-select">
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="Customer">Customer</option>
                            </select>
                            <span asp-validation-for="Role" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="form-label">
                            <i class="fas fa-map-marker-alt"></i>
                            Địa chỉ
                        </label>
                        <textarea asp-for="Address" class="glass-textarea" rows="3" placeholder="Nhập địa chỉ..."></textarea>
                        <span asp-validation-for="Address" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-image"></i>
                            Ảnh đại diện
                        </label>
                        
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <div class="current-image-container">
                                <div class="current-image-header">
                                    <span>Ảnh hiện tại:</span>
                                    <button type="button" class="glass-btn-sm danger" onclick="removeCurrentImage()" title="Xóa ảnh hiện tại">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                <img src="@Model.ProfileImageUrl" alt="Current Profile" class="current-image" id="currentImage" />
                                <input type="hidden" name="RemoveCurrentImage" id="removeCurrentImageField" value="false" />
                            </div>
                        }
                        
                        <div class="file-upload-container">
                            <input type="file" name="ProfileImage" class="file-input" id="profileImageInput" accept="image/*" onchange="previewImage(this)" />
                            <label for="profileImageInput" class="file-upload-label">
                                <div class="upload-icon">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <div class="upload-text">
                                    <span class="upload-title">Chọn ảnh mới</span>
                                    <span class="upload-subtitle">JPG, PNG, GIF - Tối đa 5MB</span>
                                </div>
                            </label>
                            <div class="image-preview-container">
                                <img id="imagePreview" src="#" alt="Preview" class="image-preview" style="display: none;" />
                                <button type="button" class="remove-image" onclick="removeImage()" style="display: none;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Index" class="glass-btn secondary">
                            <i class="fas fa-arrow-left"></i>
                            <span>Quay lại</span>
                        </a>
                        <button type="submit" class="glass-btn primary">
                            <i class="fas fa-save"></i>
                            <span>Cập nhật người dùng</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function togglePasswordChange() {
            const section = document.getElementById('passwordChangeSection');
            const isVisible = section.style.display !== 'none';
            
            if (isVisible) {
                section.style.display = 'none';
                section.classList.remove('show');
            } else {
                section.style.display = 'block';
                setTimeout(() => section.classList.add('show'), 10);
            }
        }

        function savePasswordChange() {
            const newPassword = document.getElementById('NewPassword').value;
            const confirmPassword = document.getElementById('ConfirmPassword').value;
            
            if (!newPassword) {
                alert('Vui lòng nhập mật khẩu mới');
                return;
            }
            
            if (newPassword !== confirmPassword) {
                alert('Mật khẩu xác nhận không khớp');
                return;
            }
            
            // Hide the password change section
            togglePasswordChange();
            
            // Show success message
            showToast('Mật khẩu sẽ được cập nhật khi lưu thông tin', 'success');
        }

        function cancelPasswordChange() {
            document.getElementById('NewPassword').value = '';
            document.getElementById('ConfirmPassword').value = '';
            togglePasswordChange();
        }

        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const removeBtn = document.querySelector('.remove-image');
            const file = input.files[0];
            
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    removeBtn.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none';
                removeBtn.style.display = 'none';
            }
        }

        function removeImage() {
            const preview = document.getElementById('imagePreview');
            const input = document.getElementById('profileImageInput');
            const removeBtn = document.querySelector('.remove-image');
            
            preview.style.display = 'none';
            removeBtn.style.display = 'none';
            input.value = '';
        }

        function removeCurrentImage() {
            const currentImage = document.getElementById('currentImage');
            const removeField = document.getElementById('removeCurrentImageField');
            const container = document.querySelector('.current-image-container');
            
            if (confirm('Bạn có chắc chắn muốn xóa ảnh hiện tại?')) {
                container.style.opacity = '0.5';
                removeField.value = 'true';
                showToast('Ảnh sẽ được xóa khi lưu thông tin', 'warning');
            }
        }

        function showToast(message, type = 'info') {
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `toast-message ${type}`;
            toast.innerHTML = `
                <div class="toast-content">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle'}"></i>
                    <span>${message}</span>
                </div>
            `;
            
            document.body.appendChild(toast);
            
            // Show toast
            setTimeout(() => toast.classList.add('show'), 100);
            
            // Hide toast after 3 seconds
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => document.body.removeChild(toast), 300);
            }, 3000);
        }

        // Add form animations
        document.addEventListener('DOMContentLoaded', function() {
            const formGroups = document.querySelectorAll('.form-group');
            formGroups.forEach((group, index) => {
                group.style.animationDelay = `${index * 0.1}s`;
                group.classList.add('fade-in-up');
            });

            // Validation error styling
            const inputs = document.querySelectorAll('.glass-input, .glass-select, .glass-textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    const errorSpan = this.parentNode.querySelector('.field-error');
                    if (errorSpan && errorSpan.textContent.trim()) {
                        this.classList.add('error');
                    } else {
                        this.classList.remove('error');
                    }
                });

                input.addEventListener('input', function() {
                    this.classList.remove('error');
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        /* Import Google Fonts */
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        :root {
            --primary-blue: #0066cc;
            --secondary-blue: #4da6ff;
            --light-blue: #e6f3ff;
            --dark-blue: #004499;
            --ocean-blue: #1e88e5;
            --sky-blue: #42a5f5;
            
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --medium-gray: #e9ecef;
            --dark-gray: #495057;
            --text-primary: #2c3e50;
            --text-secondary: #6c757d;
            
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            
            --shadow-light: 0 8px 32px rgba(31, 38, 135, 0.1);
            --shadow-medium: 0 12px 40px rgba(31, 38, 135, 0.15);
            --shadow-strong: 0 16px 48px rgba(31, 38, 135, 0.2);
            --shadow-neumorphism: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;
            
            --gradient-primary: linear-gradient(135deg, var(--primary-blue) 0%, var(--ocean-blue) 100%);
            --gradient-secondary: linear-gradient(135deg, var(--secondary-blue) 0%, var(--sky-blue) 100%);
            --gradient-light: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            color: var(--text-primary);
        }

        .users-container {
            padding: 2rem 1rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 3rem;
        }

        .header-content {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: var(--shadow-neumorphism);
            border: 1px solid rgba(255, 255, 255, 0.3);
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        .header-content::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-primary);
            opacity: 0.1;
            border-radius: 30px;
        }

        .header-title {
            position: relative;
            z-index: 1;
        }

        .title-icon {
            width: 80px;
            height: 80px;
            background: var(--gradient-primary);
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: var(--shadow-medium);
        }

        .title-icon i {
            font-size: 2.5rem;
            color: white;
        }

        .header-title h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-title p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            margin: 0;
            font-weight: 400;
        }

        .form-container {
            display: flex;
            justify-content: center;
        }

        .form-card {
            width: 100%;
            max-width: 800px;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            box-shadow: var(--shadow-neumorphism);
            border: 1px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-strong);
        }

        .glass-card .card-header {
            padding: 1.5rem 2rem;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }

        .glass-card .card-header h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-primary);
        }

        .glass-card .card-header i {
            color: var(--primary-blue);
            font-size: 1.3rem;
        }

        .glass-card .card-body {
            padding: 2rem;
        }

        .glass-form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }

        .form-label {
            font-weight: 600;
            color: var(--text-primary);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-label i {
            color: var(--primary-blue);
            font-size: 0.9rem;
        }

        .glass-input, .glass-select, .glass-textarea {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 12px;
            padding: 0.8rem 1rem;
            width: 100%;
            color: var(--text-primary);
            font-size: 0.95rem;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-light);
        }

        .glass-input:focus, .glass-select:focus, .glass-textarea:focus {
            outline: none;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1), var(--shadow-medium);
            background: rgba(255, 255, 255, 0.9);
        }

        .glass-input.readonly {
            background: rgba(108, 117, 125, 0.1);
            color: var(--text-secondary);
            cursor: not-allowed;
        }

        .glass-textarea {
            resize: vertical;
            min-height: 100px;
        }

        .field-error {
            color: var(--danger);
            font-size: 0.85rem;
            font-weight: 500;
            margin-top: 0.25rem;
        }

        .field-note {
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-style: italic;
        }

        .password-container {
            display: flex;
            gap: 0.5rem;
            align-items: stretch;
        }

        .password-container .glass-input {
            flex: 1;
        }

        .password-change-section {
            margin-top: 1rem;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
            opacity: 0;
            transform: translateY(-10px);
        }

        .password-change-section.show {
            opacity: 1;
            transform: translateY(0);
        }

        .password-change-header {
            background: rgba(255, 255, 255, 0.3);
            padding: 1rem 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .password-change-header h4 {
            margin: 0;
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .password-change-header i {
            color: var(--warning);
        }

        .password-change-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .password-actions {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
        }

        .current-image-container {
            margin-bottom: 1rem;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            padding: 1rem;
            transition: all 0.3s ease;
        }

        .current-image-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .current-image {
            max-width: 200px;
            max-height: 200px;
            border-radius: 15px;
            box-shadow: var(--shadow-medium);
            transition: all 0.3s ease;
            display: block;
            margin: 0 auto;
        }

        .file-upload-container {
            position: relative;
        }

        .file-input {
            display: none;
        }

        .file-upload-label {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border: 2px dashed rgba(0, 102, 204, 0.3);
            border-radius: 15px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-light);
        }

        .file-upload-label:hover {
            border-color: var(--primary-blue);
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-2px);
            box-shadow: var(--shadow-medium);
        }

        .upload-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }

        .upload-text {
            text-align: center;
        }

        .upload-title {
            display: block;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.25rem;
        }

        .upload-subtitle {
            display: block;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .image-preview-container {
            position: relative;
            margin-top: 1rem;
            text-align: center;
        }

        .image-preview {
            max-width: 200px;
            max-height: 200px;
            border-radius: 15px;
            box-shadow: var(--shadow-medium);
            transition: all 0.3s ease;
        }

        .remove-image {
            position: absolute;
            top: -10px;
            right: calc(50% - 110px);
            background: var(--danger);
            color: white;
            border: none;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--shadow-light);
            transition: all 0.3s ease;
        }

        .remove-image:hover {
            transform: scale(1.1);
            box-shadow: var(--shadow-medium);
        }

        .glass-btn {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            padding: 0.8rem 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow-light);
            cursor: pointer;
            position: relative;
            z-index: 1;
            overflow: hidden;
        }

        .glass-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-light);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }

        .glass-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-medium);
            text-decoration: none;
            color: var(--text-primary);
        }

        .glass-btn:hover::before {
            opacity: 1;
        }

        .glass-btn.primary {
            background: var(--gradient-primary);
            color: white;
        }

        .glass-btn.primary::before {
