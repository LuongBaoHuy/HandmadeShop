<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HandmadeShop Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/doan1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        /* Glassmorphism Navbar Styles */
        .glassmorphism-navbar {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 
                0 8px 32px rgba(31, 38, 135, 0.37),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
            padding: 1rem 0;
            margin-bottom: 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            transition: all 0.3s ease;
        }

        .glassmorphism-navbar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, 
                rgba(0, 102, 204, 0.1) 0%, 
                rgba(30, 136, 229, 0.05) 50%, 
                rgba(66, 165, 245, 0.1) 100%);
            pointer-events: none;
        }

        /* Brand Styling */
        .glassmorphism-navbar .navbar-brand {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: #2c3e50;
            font-weight: 700;
            font-size: 1.4rem;
            text-decoration: none;
            position: relative;
            z-index: 2;
            transition: all 0.3s ease;
        }

        .glassmorphism-navbar .navbar-brand:hover {
            color: #0066cc;
            transform: translateY(-2px);
        }

        .brand-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #0066cc 0%, #1e88e5 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 
                0 4px 16px rgba(0, 102, 204, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .brand-text {
            background: linear-gradient(135deg, #0066cc 0%, #1e88e5 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            color: transparent;
        }

        /* Navigation Links */
        .glassmorphism-navbar .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 0.75rem 1.2rem;
            border-radius: 12px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
            margin: 0 0.25rem;
        }

        .glassmorphism-navbar .nav-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .glassmorphism-navbar .nav-link:hover {
            color: #0066cc;
            transform: translateY(-2px);
            box-shadow: 
                0 4px 16px rgba(0, 102, 204, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        .glassmorphism-navbar .nav-link:hover::before {
            opacity: 1;
        }

        .glassmorphism-navbar .nav-link i {
            font-size: 1rem;
            color: #0066cc;
        }

        /* User Avatar Section */
        .user-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4da6ff 0%, #42a5f5 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 
                0 4px 16px rgba(77, 166, 255, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .user-info {
            display: flex;
            flex-direction: column;
            margin-left: 0.75rem;
        }

        .user-name {
            font-weight: 600;
            font-size: 0.95rem;
            color: #2c3e50;
        }

        .user-role {
            font-size: 0.8rem;
            color: #0066cc;
            background: rgba(0, 102, 204, 0.1);
            padding: 0.2rem 0.6rem;
            border-radius: 8px;
            margin-top: 0.2rem;
            width: fit-content;
        }

        /* Dropdown Menu */
        .glassmorphism-dropdown {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 
                0 12px 40px rgba(31, 38, 135, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.6),
                inset 0 -1px 0 rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 0.5rem;
            margin-top: 0.5rem;
        }

        .glassmorphism-dropdown .dropdown-item {
            color: #2c3e50;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 500;
            background: rgba(255, 255, 255, 0.1);
            margin: 0.2rem 0;
        }

        .glassmorphism-dropdown .dropdown-item:hover {
            background: rgba(0, 102, 204, 0.15);
            color: #0066cc;
            transform: translateX(5px);
            box-shadow: 
                0 4px 16px rgba(0, 102, 204, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        .glassmorphism-dropdown .dropdown-item i {
            color: #0066cc;
            width: 16px;
        }

        .glassmorphism-dropdown .dropdown-header {
            color: #2c3e50;
            font-weight: 600;
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(0, 102, 204, 0.1);
            border-radius: 8px;
            margin-bottom: 0.5rem;
        }

        .glassmorphism-dropdown .dropdown-divider {
            border-color: rgba(0, 102, 204, 0.3);
            margin: 0.5rem 0;
            opacity: 0.6;
        }

        .logout-btn {
            background: transparent;
            border: none;
            width: 100%;
            text-align: left;
            color: #2c3e50;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444 !important;
            box-shadow: 
                0 4px 16px rgba(239, 68, 68, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        /* Mobile Toggler */
        .glassmorphism-navbar .navbar-toggler {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 0.5rem;
            background: rgba(255, 255, 255, 0.1);
        }

        .custom-toggler-icon {
            color: #0066cc;
            font-size: 1.2rem;
        }

        /* Responsive */
        @@media (max-width: 991px) {
            .glassmorphism-navbar .navbar-collapse {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(30px);
                border-radius: 15px;
                margin-top: 1rem;
                padding: 1rem;
                border: 1px solid rgba(255, 255, 255, 0.4);
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                z-index: 1000;
                box-shadow: 
                    0 12px 40px rgba(31, 38, 135, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.6);
            }

            .glassmorphism-navbar .container-fluid {
                flex-wrap: wrap;
            }

            .glassmorphism-navbar .navbar-brand {
                order: 2;
                flex: 1;
                justify-content: center;
            }

            .navbar-nav.me-auto {
                order: 1;
            }

            .navbar-nav.ms-auto {
                order: 3;
            }

            .user-info {
                margin-left: 0.5rem;
                margin-top: 0;
            }

            .user-name {
                font-size: 0.9rem;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="glassmorphism-navbar">
            <div class="container-fluid d-flex align-items-center">
                <div class="navbar-nav me-auto">
                    <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="custom-toggler-icon">
                            <i class="fas fa-bars"></i>
                        </span>
                    </button>
                    <div class="d-none d-lg-flex">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i> <span>Trang chủ</span>
                        </a>
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-cogs"></i> <span>Quản lý</span>
                            </a>
                            <ul class="dropdown-menu glassmorphism-dropdown">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">
                                        <i class="fas fa-users"></i> Người dùng
                                    </a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                                    <i class="fas fa-tags"></i> Danh mục
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">
                                    <i class="fas fa-box"></i> Sản phẩm
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                                    <i class="fas fa-shopping-cart"></i> Đơn hàng
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Vouchers" asp-action="Index">
                                    <i class="fas fa-ticket-alt"></i> Voucher
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Questions" asp-action="Index">
                                    <i class="fas fa-question-circle"></i> Câu hỏi khách hàng
                                </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="fas fa-store"></i>
                    </div>
                    <span class="brand-text">HandmadeShop Admin</span>
                </a>
                
                <div class="navbar-nav ms-auto">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            <div class="user-avatar">
                                <i class="fas fa-user-circle"></i>
                            </div>
                            <span class="user-info">
                                <span class="user-name">@User.FindFirst("FullName")?.Value</span>
                                <span class="user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glassmorphism-dropdown">
                            <li><h6 class="dropdown-header">
                                <i class="fas fa-user"></i> @User.Identity?.Name
                            </h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Auth" asp-action="Logout" class="d-inline">
                                    <button type="submit" class="dropdown-item logout-btn">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="navbar-collapse collapse d-lg-none">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> <span>Trang chủ</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-cogs"></i> <span>Quản lý</span>
                            </a>
                            <ul class="dropdown-menu glassmorphism-dropdown">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">
                                        <i class="fas fa-users"></i> Người dùng
                                    </a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                                    <i class="fas fa-tags"></i> Danh mục
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">
                                    <i class="fas fa-box"></i> Sản phẩm
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                                    <i class="fas fa-shopping-cart"></i> Đơn hàng
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Vouchers" asp-action="Index">
                                    <i class="fas fa-ticket-alt"></i> Voucher
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Questions" asp-action="Index">
                                    <i class="fas fa-question-circle"></i> Câu hỏi khách hàng
                                </a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(ViewBag.ContainerClass ?? "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - doan1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
