@model IEnumerable<doan1.Models.Question>

@{
    ViewData["Title"] = "Quản lý câu hỏi";
}

@section Styles {
    <style>
        body {
            background: #ffffff;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .glass-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            border: 1px solid rgba(224, 230, 237, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        
        .neuro-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 
                8px 8px 16px rgba(163, 177, 198, 0.4),
                -8px -8px 16px rgba(255, 255, 255, 0.9);
            border: none;
            transition: all 0.3s ease;
            overflow: hidden;
        }
        
        .neuro-card:hover {
            transform: translateY(-2px);
            box-shadow: 
                12px 12px 24px rgba(163, 177, 198, 0.5),
                -12px -12px 24px rgba(255, 255, 255, 1);
        }
        
        .stats-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
            border-radius: 20px;
            box-shadow: 
                8px 8px 16px rgba(59, 130, 246, 0.3),
                -8px -8px 16px rgba(255, 255, 255, 0.9);
            border: none;
            transition: all 0.3s ease;
        }
        
        .stats-card:hover {
            transform: translateY(-3px);
            box-shadow: 
                12px 12px 24px rgba(59, 130, 246, 0.4),
                -12px -12px 24px rgba(255, 255, 255, 1);
        }
        
        .btn-neuro {
            background: #ffffff;
            border: none;
            border-radius: 15px;
            padding: 12px 24px;
            font-weight: 600;
            color: #1e3a8a;
            box-shadow: 
                6px 6px 12px rgba(163, 177, 198, 0.4),
                -6px -6px 12px rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
        }
        
        .btn-neuro:hover {
            color: #3b82f6;
            box-shadow: 
                3px 3px 6px rgba(163, 177, 198, 0.4),
                -3px -3px 6px rgba(255, 255, 255, 0.8);
            transform: translateY(1px);
        }
        
        .btn-primary-neuro {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none;
            border-radius: 15px;
            padding: 12px 24px;
            font-weight: 600;
            color: white;
            box-shadow: 
                6px 6px 12px rgba(59, 130, 246, 0.4),
                -6px -6px 12px rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
        }
        
        .btn-primary-neuro:hover {
            color: white;
            box-shadow: 
                3px 3px 6px rgba(59, 130, 246, 0.4),
                -3px -3px 6px rgba(255, 255, 255, 0.8);
            transform: translateY(1px);
        }
        
        .form-neuro {
            background: #ffffff;
            border: none;
            border-radius: 15px;
            padding: 12px 16px;
            box-shadow: 
                inset 4px 4px 8px rgba(163, 177, 198, 0.2),
                inset -4px -4px 8px rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
        }
        
        .form-neuro:focus {
            box-shadow: 
                inset 6px 6px 12px rgba(163, 177, 198, 0.3),
                inset -6px -6px 12px rgba(255, 255, 255, 0.9),
                0 0 0 3px rgba(102, 126, 234, 0.1);
            outline: none;
        }
        
        .badge-neuro {
            border-radius: 12px;
            padding: 8px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        .badge-pending {
            background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);
            color: #2d3436;
        }
        
        .badge-answered {
            background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
            color: white;
        }
        
        .badge-closed {
            background: linear-gradient(135deg, #636e72 0%, #2d3436 100%);
            color: white;
        }
        
        .header-title {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .glass-header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid rgba(224, 230, 237, 0.3);
        }
        
        .btn-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 8px;
        }
        
        .btn-success-neuro {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            color: white;
        }
        
        .btn-danger-neuro {
            background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
            color: white;
        }
    </style>
}

<div class="container-fluid" style="min-height: 100vh; padding: 2rem;">
    <!-- Header -->
    <div class="glass-container">
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <h1 class="header-title"><i class="fas fa-question-circle me-3"></i>Quản lý câu hỏi từ khách hàng</h1>
                <p class="text-muted fs-5">Theo dõi và trả lời các câu hỏi từ khách hàng một cách hiệu quả</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="@Url.Action("Index", "Home")" class="btn btn-neuro">
                    <i class="fas fa-arrow-left me-2"></i>Về Dashboard
                </a>
            </div>
        </div>

    <!-- Thông báo -->
    @if (TempData["QuestionsSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-header border-0" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["QuestionsSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["QuestionsError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show glass-header border-0" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["QuestionsError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

        <!-- Thống kê -->
        <div class="row mb-5">
        <div class="col-md-4 mb-3">
            <div class="card stats-card">
                <div class="card-body text-center py-4">
                    <i class="fas fa-clock fa-3x mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.PendingCount</h2>
                    <p class="mb-0 fs-5">Chờ trả lời</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card neuro-card">
                <div class="card-body text-center py-4" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: white; border-radius: 20px;">
                    <i class="fas fa-check-circle fa-3x mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.AnsweredCount</h2>
                    <p class="mb-0 fs-5">Đã trả lời</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card neuro-card">
                <div class="card-body text-center py-4" style="background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); color: white; border-radius: 20px;">
                    <i class="fas fa-list fa-3x mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.TotalCount</h2>
                    <p class="mb-0 fs-5">Tổng câu hỏi</p>
                </div>
            </div>
        </div>
    </div>

        <!-- Filter and Search -->
        <div class="glass-container">
            <h5 class="header-title mb-4"><i class="fas fa-filter me-2"></i>Lọc và tìm kiếm</h5>
            <form method="get" class="row g-4">
                <div class="col-md-4">
                    <label for="searchTerm" class="form-label fw-semibold">Tìm kiếm nội dung</label>
                    <input type="text" class="form-control form-neuro" id="searchTerm" name="searchTerm" 
                           value="@ViewBag.SearchTerm" placeholder="Nhập từ khóa...">
                </div>
                <div class="col-md-2">
                    <label for="status" class="form-label fw-semibold">Trạng thái</label>
                    <select class="form-select form-neuro" id="status" name="status">
                        <option value="">Tất cả</option>
                        <option value="pending" selected="@(ViewBag.Status == "pending")">Chờ trả lời</option>
                        <option value="answered" selected="@(ViewBag.Status == "answered")">Đã trả lời</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="sortBy" class="form-label fw-semibold">Sắp xếp theo</label>
                    <select class="form-select form-neuro" id="sortBy" name="sortBy">
                        <option value="createdat" selected="@(ViewBag.SortBy == "createdat")">Ngày tạo</option>
                        <option value="content" selected="@(ViewBag.SortBy == "content")">Nội dung</option>
                        <option value="status" selected="@(ViewBag.SortBy == "status")">Trạng thái</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="sortOrder" class="form-label fw-semibold">Thứ tự</label>
                    <select class="form-select form-neuro" id="sortOrder" name="sortOrder">
                        <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Mới nhất</option>
                        <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Cũ nhất</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-neuro me-2">
                        <i class="fas fa-search me-1"></i>Tìm
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-neuro">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- Questions List -->
        <div class="row">
        @if (Model.Any())
        {
            @foreach (var question in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card neuro-card h-100">
                        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                            <div>
                                @if (question.Status.ToLower() == "pending")
                                {
                                    <span class="badge badge-neuro badge-pending">
                                        <i class="fas fa-clock me-1"></i>Chờ trả lời
                                    </span>
                                }
                                else if (question.Status.ToLower() == "answered")
                                {
                                    <span class="badge badge-neuro badge-answered">
                                        <i class="fas fa-check me-1"></i>Đã trả lời
                                    </span>
                                }
                                else if (question.Status.ToLower() == "closed")
                                {
                                    <span class="badge badge-neuro badge-closed">
                                        <i class="fas fa-times me-1"></i>Đã đóng
                                    </span>
                                }
                            </div>
                            <small class="text-muted fw-semibold">
                                <i class="fas fa-calendar me-1"></i>@question.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="card-text flex-grow-1" style="line-height: 1.6; color: #2d3748;">
                                @(question.Content.Length > 200 ? question.Content.Substring(0, 200) + "..." : question.Content)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a asp-action="Details" asp-route-id="@question.Id" class="btn btn-primary-neuro">
                                    <i class="fas fa-eye me-2"></i>Xem chi tiết
                                </a>
                                <div class="d-flex">
                                    @if (question.Status == "pending")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="me-2">
                                            <input type="hidden" name="id" value="@question.Id" />
                                            <input type="hidden" name="status" value="answered" />
                                            <button type="submit" class="btn btn-icon btn-success-neuro" title="Đánh dấu đã trả lời">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" method="post" 
                                          onsubmit="return confirm('Bạn có chắc muốn xóa câu hỏi này?')">
                                        <input type="hidden" name="id" value="@question.Id" />
                                        <button type="submit" class="btn btn-icon btn-danger-neuro" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="glass-container text-center py-5">
                    <i class="fas fa-question-circle fa-5x text-muted mb-4" style="opacity: 0.3;"></i>
                    <h3 class="text-muted mb-3">Không có câu hỏi nào</h3>
                    <p class="text-muted fs-5">
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || !string.IsNullOrEmpty(ViewBag.Status as string))
                        {
                            @("Không tìm thấy câu hỏi phù hợp với bộ lọc của bạn.")
                        }
                        else
                        {
                            @("Chưa có câu hỏi nào từ khách hàng.")
                        }
                    </p>
                </div>
            </div>
        }
    </div>
</div>
