@model doan1.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="products-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <h1>Chỉnh sửa sản phẩm</h1>
                <p>Cập nhật thông tin sản phẩm "@Model.Name"</p>
            <div class="edit-container">
                <form asp-action="Edit" enctype="multipart/form-data" class="product-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="form-layout">
                        <!-- Thông tin hiện tại -->
                        <div class="glass-card current-info-card">
                            <div class="card-header">
                                <h3>
                                    <i class="fas fa-info-circle"></i>
                                    Thông tin hiện tại
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="current-product-info">
                                    <div class="current-image">
                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.onerror=null; this.src='/images/no-image.png';" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="no-image-placeholder">
                                                <i class="fas fa-image"></i>
                                                <span>Chưa có ảnh</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="current-details">
                                        <h4>@Model.Name</h4>
                                        <p class="current-category">
                                            @if (Model.Category != null)
                                            {
                                                <span><i class="fas fa-tag"></i> @Model.Category.CategoriesName</span>
                                            }
                                            else
                                            {
                                                <span class="no-category">Chưa có danh mục</span>
                                            }
                                        </p>
                                        <div class="current-price-info">
                                            @if (Model.Price.HasValue)
                                            {
                                                <span class="current-price">@Model.Price.Value.ToString("C0")</span>
                                            }
                                            @if (Model.OriginalPrice.HasValue && Model.OriginalPrice.Value > 0)
                                            {
                                                <span class="original-price">@Model.OriginalPrice.Value.ToString("C0")</span>
                                            }
                                        </div>
                                        <p class="current-stock">
                                            <i class="fas fa-boxes"></i>
                                            @(Model.Stock?.ToString() ?? "0") sản phẩm trong kho
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Form chỉnh sửa -->
                    <div class="glass-card form-card">
                        <div class="card-header">
                            <h3>
                                <i class="fas fa-edit"></i>
                                Thông tin mới
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                                    <div class="input-group">
                                        <div class="input-icon"></div>
                                        <input asp-for="Name" class="glass-input" placeholder="Nhập tên sản phẩm..." />
                                    </div>
                                    <span asp-validation-for="Name" class="validation-error"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                                    <div class="input-group">
                                        <div class="input-icon"></div>
                                        <select asp-for="CategoryId" class="glass-select" asp-items="ViewBag.CategoryId"></select>
                                    </div>
                                    <span asp-validation-for="CategoryId" class="validation-error"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Description" class="form-label">Mô tả sản phẩm</label>
                                <textarea asp-for="Description" class="glass-textarea" rows="4" placeholder="Nhập mô tả chi tiết về sản phẩm..."></textarea>
                                <span asp-validation-for="Description" class="validation-error"></span>
                            </div>
                            <div class="form-grid-3">
                                <div class="form-group">
                                    <label asp-for="OriginalPrice" class="form-label">Giá gốc</label>
                                    <div class="input-group">
                                        <div class="input-icon"></div>
                                        <input asp-for="OriginalPrice" class="glass-input" type="number" step="0.01" min="0" placeholder="0" />
                                        <div class="input-suffix">VNĐ</div>
                                    </div>
                                    <span asp-validation-for="OriginalPrice" class="validation-error"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="DiscountedPrice" class="form-label">Giá khuyến mãi</label>
                                    <div class="input-group">
                                        <div class="input-icon"></div>
                                        <input asp-for="DiscountedPrice" class="glass-input" type="number" step="0.01" min="0" placeholder="0" />
                                        <div class="input-suffix">VNĐ</div>
                                    </div>
                                    <span asp-validation-for="DiscountedPrice" class="validation-error"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Price" class="form-label">Giá bán</label>
                                    <div class="input-group">
                                        <div class="input-icon"></div>
                                        <input asp-for="Price" class="glass-input" type="number" step="0.01" min="0" placeholder="0" />
                                        <div class="input-suffix">VNĐ</div>
                                    </div>
                                    <span asp-validation-for="Price" class="validation-error"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Stock" class="form-label">Số lượng tồn kho</label>
                                <div class="input-group">
                                    <div class="input-icon"><i class="fas fa-boxes"></i></div>
                                    <input asp-for="Stock" class="glass-input" type="number" min="0" placeholder="0" />
                                    <div class="input-suffix">sản phẩm</div>
                                </div>
                                <span asp-validation-for="Stock" class="validation-error"></span>
                            </div>
                        </div>
                    </div>
                    <!-- Upload ảnh mới -->
                    <div class="glass-card image-card">
                        <div class="card-header">
                            <h3>
                                <i class="fas fa-images"></i>
                                Cập nhật hình ảnh
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="ProductImage" class="form-label">Chọn ảnh mới (tùy chọn)</label>
                                <div class="file-upload-area" id="fileUploadArea">
                                    <input type="file" class="file-input" id="ProductImage" name="ProductImage" accept="image/*" />
                                    <input type="hidden" asp-for="ImageUrl" />
                                    <div class="upload-content">
                                        <div class="upload-icon"></div>
                                        <h4>Kéo thả ảnh mới vào đây hoặc click để chọn</h4>
                                        <p>Để trống nếu không muốn thay đổi ảnh. Chấp nhận: JPG, JPEG, PNG, GIF, BMP. Tối đa 5MB.</p>
                                    </div>
                                    <div class="upload-preview" id="uploadPreview" style="display: none;">
                                        <img id="imagePreview" src="#" alt="Xem trước ảnh" />
                                        <div class="preview-overlay"></div>
                                    </div>
                                </div>
                                <span asp-validation-for="ImageUrl" class="validation-error"></span>
                            </div>
                        </div>
                    </div>
                    <!-- Preview thay đổi -->
                    <div class="glass-card preview-card">
                        <div class="card-header">
                            <h3>
                                <i class="fas fa-eye"></i>
                                Xem trước thay đổi
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="change-preview" id="changePreview">
                                <div class="preview-image">
                                    <div class="current-image-preview">
                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl" alt="Ảnh hiện tại" style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;" />
                                        }
                                        else
                                        {
                                            <div class="placeholder-image"><i class="fas fa-image"></i> Không có ảnh</div>
                                        }
                                    </div>
                                    <div class="arrow-icon">
                                        <i class="fas fa-arrow-right"></i>
                                    </div>
                                    <div class="new-image-preview">
                                        <img id="newPreviewImage" style="display: none;" alt="Ảnh mới" />
                                    </div>
                                </div>
                                <div class="preview-info">
                                    <h4 id="previewName">@Model.Name</h4>
                                    <p id="previewCategory" class="category-preview"></p>
                                    <div class="price-preview"></div>
                                    <p id="previewDescription" class="description-preview">@Model.Description</p>
                                    <div class="stock-preview"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Quản lý biến thể sản phẩm -->
                    <div class="glass-card variations-card">
                        <div class="card-header">
                            <h3>
                                <i class="fas fa-layer-group"></i>
                                Quản lý biến thể sản phẩm
                            </h3>
                            <button type="button" class="glass-btn primary" id="generateVariationsBtn">
                                <i class="fas fa-magic"></i>
                                <span>Tạo biến thể</span>
                            </button>
                        </div>
                        <div class="card-body">
                            <!-- Tab Navigation -->
                            <ul class="nav nav-tabs variation-tabs" id="variationTabs">
                                <li class="nav-item">
                                    <a class="nav-link active" id="attributes-tab" data-bs-toggle="tab" href="#attributes" role="tab">
                                        <i class="fas fa-tags"></i>
                                        Thuộc tính
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="variations-tab" data-bs-toggle="tab" href="#variations" role="tab">
                                        <i class="fas fa-layer-group"></i>
                                        Biến thể
                                    </a>
                                </li>
                            </ul>
                            <!-- Tab Content -->
                            <div class="tab-content variation-tab-content">
                                <!-- Attributes Tab -->
                                <div class="tab-pane fade show active" id="attributes" role="tabpanel">
                                    <div class="attributes-container">
                                        <div class="attributes-header"></div>
                                        <div id="attributesList" class="attributes-list"></div>
                                    </div>
                                </div>
                                <!-- Variations Tab -->
                                <div class="tab-pane fade" id="variations" role="tabpanel">
                                    <div class="variations-container">
                                        <div class="variations-header"></div>
                                        <div class="variation-table-container"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Action buttons -->
                    <div class="glass-card actions-card">
                        <div class="card-body">
                            <div class="action-buttons">
                                <a asp-action="Index" class="glass-btn secondary large">
                                    <i class="fas fa-arrow-left"></i>
                                    <span>Quay lại danh sách</span>
                                </a>
                                <button type="submit" class="glass-btn success large">
                                    <i class="fas fa-save"></i>
                                    <span>Cập nhật sản phẩm</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
                        </li>
                    </ul>
                    
                    <!-- Tab Content -->
                    <div class="tab-content variation-tab-content">
                        <!-- Attributes Tab -->
                        <div class="tab-pane fade show active" id="attributes" role="tabpanel">
                            <div class="attributes-container">
                                <div class="attributes-header">
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i>
                                        Thêm các thuộc tính như màu sắc, kích thước cho sản phẩm. Sau đó tạo biến thể để có giá và tồn kho riêng.
                                    </p>
                                    <button type="button" class="glass-btn secondary" id="addAttributeBtn">
                                        <i class="fas fa-plus"></i>
                                        <span>Thêm thuộc tính</span>
                                    </button>
                                </div>
                                
                                <div id="attributesList" class="attributes-list">
                                    <!-- Dynamic attribute fields will be added here -->
                                </div>
                            </div>
                        </div>
                        
                        <!-- Variations Tab -->
                        <div class="tab-pane fade" id="variations" role="tabpanel">
                            <div class="variations-container">
                                <div class="variations-header">
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i>
                                        Quản lý giá và tồn kho cho từng biến thể sản phẩm.
                                    </p>
                                </div>
                                
                                <div class="variation-table-container">
                                    <table class="table variation-table" id="variationsTable">
                                        <thead>
                                            <tr>
                                                <th>Tổ hợp thuộc tính</th>
                                                <th>Giá (VNĐ)</th>
                                                <th>Tồn kho</th>
                                                <th>Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Variations will be generated here -->
                                        </tbody>
                                    </table>
                                    
                                    <div class="empty-variations" id="emptyVariations">
                                        <div class="empty-icon">
                                            <i class="fas fa-layer-group"></i>
                                        </div>
                                        <h4>Chưa có biến thể nào</h4>
                                        <p>Thêm thuộc tính và nhấn "Tạo biến thể" để bắt đầu.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="glass-card actions-card">
                <div class="card-body">
                    <div class="action-buttons">
                        <a asp-action="Index" class="glass-btn secondary large">
                            <i class="fas fa-arrow-left"></i>
                            <span>Quay lại danh sách</span>
                        </a>
                        <button type="submit" class="glass-btn success large">
                            <i class="fas fa-save"></i>
                            <span>Cập nhật sản phẩm</span>
                        </button>
                    </div>
                </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('ProductImage');
            const uploadArea = document.getElementById('fileUploadArea');
            const uploadPreview = document.getElementById('uploadPreview');
            const imagePreview = document.getElementById('imagePreview');
            const removeImageBtn = document.getElementById('removeImage');
            
            const newPreviewImage = document.getElementById('newPreviewImage');
            const newImagePlaceholder = document.getElementById('newImagePlaceholder');
            
            // Form inputs for live preview
            const nameInput = document.querySelector('input[name="Name"]');
            const categorySelect = document.querySelector('select[name="CategoryId"]');
            const descriptionInput = document.querySelector('textarea[name="Description"]');
            const priceInput = document.querySelector('input[name="Price"]');
            const originalPriceInput = document.querySelector('input[name="OriginalPrice"]');
            const stockInput = document.querySelector('input[name="Stock"]');

            // Preview elements
            const previewName = document.getElementById('previewName');
            const previewCategory = document.getElementById('previewCategory');
            const previewDescription = document.getElementById('previewDescription');
            const previewPrice = document.getElementById('previewPrice');
            const previewOriginalPrice = document.getElementById('previewOriginalPrice');
            const previewStock = document.getElementById('previewStock');

            // File upload handling
            uploadArea.addEventListener('click', () => fileInput.click());
            
            uploadArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                uploadArea.classList.add('drag-over');
            });
            
            uploadArea.addEventListener('dragleave', () => {
                uploadArea.classList.remove('drag-over');
            });
            
            uploadArea.addEventListener('drop', (e) => {
                e.preventDefault();
                uploadArea.classList.remove('drag-over');
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    handleFileSelect(files[0]);
                }
            });
            
            fileInput.addEventListener('change', function(e) {
                if (e.target.files.length > 0) {
                    handleFileSelect(e.target.files[0]);
                }
            });
            
            removeImageBtn.addEventListener('click', function() {
                fileInput.value = '';
                uploadPreview.style.display = 'none';
                uploadArea.querySelector('.upload-content').style.display = 'flex';
                
                newPreviewImage.style.display = 'none';
                newImagePlaceholder.style.display = 'flex';
            });

            function handleFileSelect(file) {
                // Validate file size
                if (file.size > 5242880) {
                    alert('File quá lớn! Vui lòng chọn file nhỏ hơn 5MB.');
                    return;
                }
                
                // Validate file type
                if (!file.type.startsWith('image/')) {
                    alert('Vui lòng chọn file ảnh!');
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    uploadPreview.style.display = 'block';
                    uploadArea.querySelector('.upload-content').style.display = 'none';
                    
                    // Update new image preview
                    newPreviewImage.src = e.target.result;
                    newPreviewImage.style.display = 'block';
                    newImagePlaceholder.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }

            // Live preview updates
            function updatePreview() {
                // Name
                if (nameInput.value.trim()) {
                    previewName.textContent = nameInput.value;
                }

                // Category
                if (categorySelect.value) {
                    const selectedOption = categorySelect.options[categorySelect.selectedIndex];
                    previewCategory.innerHTML = '<span>' + selectedOption.text + '</span>';
                    previewCategory.className = 'category-preview selected';
                }

                // Description
                if (descriptionInput.value.trim()) {
                    previewDescription.textContent = descriptionInput.value;
                }

                // Price
                const price = parseFloat(priceInput.value) || 0;
                const originalPrice = parseFloat(originalPriceInput.value) || 0;
                
                if (price > 0) {
                    previewPrice.textContent = price.toLocaleString('vi-VN') + ' VNĐ';
                }
                
                if (originalPrice > 0 && originalPrice > price) {
                    previewOriginalPrice.textContent = originalPrice.toLocaleString('vi-VN') + ' VNĐ';
                    previewOriginalPrice.style.display = 'inline';
                } else {
                    previewOriginalPrice.style.display = 'none';
                }

                // Stock
                const stock = parseInt(stockInput.value) || 0;
                previewStock.textContent = stock + ' sản phẩm trong kho';
            }

            // Add event listeners for live preview
            [nameInput, categorySelect, descriptionInput, priceInput, originalPriceInput, stockInput].forEach(input => {
                if (input) {
                    input.addEventListener('input', updatePreview);
                    input.addEventListener('change', updatePreview);
                }
            });

            // ===== VARIATION MANAGEMENT =====
            let attributeCounter = 0;
            const productId = @Model.Id;

            // Load existing variations when page loads
            loadProductVariations();

            // Add attribute button
            document.getElementById('addAttributeBtn').addEventListener('click', function() {
                addAttributeField();
            });

            // Generate variations button
            document.getElementById('generateVariationsBtn').addEventListener('click', function() {
                generateVariations();
            });

            function addAttributeField() {
                attributeCounter++;
                const attributesList = document.getElementById('attributesList');
                
                const attributeItem = document.createElement('div');
                attributeItem.className = 'attribute-item';
                attributeItem.setAttribute('data-attr-id', attributeCounter);
                
                attributeItem.innerHTML = `
                    <div class="attribute-header">
                        <input type="text" class="glass-input attribute-name" placeholder="Tên thuộc tính (vd: Màu sắc)" required>
                        <button type="button" class="glass-btn danger small remove-attribute">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    <div class="attribute-options">
                        <div class="options-list">
                            <div class="option-item">
                                <input type="text" class="glass-input option-value" placeholder="Giá trị (vd: Đỏ)" required>
                                <button type="button" class="glass-btn danger small remove-option">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <button type="button" class="glass-btn secondary small add-option">
                            <i class="fas fa-plus"></i>
                            <span>Thêm giá trị</span>
                        </button>
                    </div>
                `;
                
                attributesList.appendChild(attributeItem);
                
                // Add event listeners for new attribute
                setupAttributeEvents(attributeItem);
            }

            function setupAttributeEvents(attributeItem) {
                // Remove attribute
                attributeItem.querySelector('.remove-attribute').addEventListener('click', function() {
                    attributeItem.remove();
                });
                
                // Add option
                attributeItem.querySelector('.add-option').addEventListener('click', function() {
                    addOptionField(attributeItem);
                });
                
                // Remove option
                attributeItem.addEventListener('click', function(e) {
                    if (e.target.classList.contains('remove-option') || e.target.parentElement.classList.contains('remove-option')) {
                        const optionItem = e.target.closest('.option-item');
                        const optionsList = optionItem.parentElement;
                        if (optionsList.children.length > 1) {
                            optionItem.remove();
                        } else {
                            alert('Thuộc tính phải có ít nhất một giá trị!');
                        }
                    }
                });
            }

            function addOptionField(attributeItem) {
                const optionsList = attributeItem.querySelector('.options-list');
                const optionItem = document.createElement('div');
                optionItem.className = 'option-item';
                optionItem.innerHTML = `
                    <input type="text" class="glass-input option-value" placeholder="Giá trị" required>
                    <button type="button" class="glass-btn danger small remove-option">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                optionsList.appendChild(optionItem);
            }

            function generateVariations() {
                const attributes = collectAttributes();
                if (attributes.length === 0) {
                    alert('Vui lòng thêm ít nhất một thuộc tính!');
                    return;
                }

                // Save attributes first, then generate variations
                fetch(`/Products/GenerateVariations?productId=${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ productId: productId, attributes: attributes })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        loadProductVariations();
                        // Switch to variations tab
                        document.getElementById('variations-tab').click();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi tạo biến thể!');
                });
            }

            function collectAttributes() {
                const attributes = [];
                const attributeItems = document.querySelectorAll('.attribute-item');
                
                attributeItems.forEach(item => {
                    const name = item.querySelector('.attribute-name').value.trim();
                    if (!name) return;
                    
                    const options = [];
                    const optionInputs = item.querySelectorAll('.option-value');
                    optionInputs.forEach(input => {
                        const value = input.value.trim();
                        if (value) options.push(value);
                    });
                    
                    if (options.length > 0) {
                        attributes.push({ name, options });
                    }
                });
                
                return attributes;
            }

            function loadProductVariations() {
                fetch(`/api/products/${productId}/variations`)
                .then(response => response.json())
                .then(variations => {
                    displayVariations(variations);
                })
                .catch(error => {
                    console.error('Error loading variations:', error);
                });
            }

            function displayVariations(variations) {
                const tbody = document.querySelector('#variationsTable tbody');
                const emptyState = document.getElementById('emptyVariations');
                
                tbody.innerHTML = '';
                
                if (variations.length === 0) {
                    emptyState.style.display = 'block';
                    document.getElementById('variationsTable').style.display = 'none';
                } else {
                    emptyState.style.display = 'none';
                    document.getElementById('variationsTable').style.display = 'table';
                    
                    variations.forEach(variation => {
                        // Create display name from attributes
                        const displayName = variation.attributes
                            .map(attr => `${attr.attributeName}: ${attr.optionValue}`)
                            .join(', ');
                            
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td>
                                <div class="variation-attributes">
                                    ${displayName}
                                </div>
                            </td>
                            <td>
                                <input type="number" class="glass-input variation-price" 
                                       value="${variation.price}" 
                                       data-variation-id="${variation.id}"
                                       min="0" step="1000">
                            </td>
                            <td>
                                <input type="number" class="glass-input variation-stock" 
                                       value="${variation.stock}" 
                                       data-variation-id="${variation.id}"
                                       min="0">
                            </td>
                            <td>
                                <div class="variation-actions">
                                    <button type="button" class="glass-btn success small save-variation" 
                                            data-variation-id="${variation.id}">
                                        <i class="fas fa-save"></i>
                                    </button>
                                    <button type="button" class="glass-btn danger small delete-variation" 
                                            data-variation-id="${variation.id}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(row);
                    });
                    
                    // Add event listeners for variation actions
                    setupVariationEvents();
                }
            }

            function setupVariationEvents() {
                // Save variation
                document.querySelectorAll('.save-variation').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const variationId = this.getAttribute('data-variation-id');
                        const row = this.closest('tr');
                        const price = row.querySelector('.variation-price').value;
                        const stock = row.querySelector('.variation-stock').value;
                        
                        updateVariation(variationId, price, stock);
                    });
                });
                
                // Delete variation
                document.querySelectorAll('.delete-variation').forEach(btn => {
                    btn.addEventListener('click', function() {
                        if (confirm('Bạn có chắc chắn muốn xóa biến thể này?')) {
                            const variationId = this.getAttribute('data-variation-id');
                            deleteVariation(variationId);
                        }
                    });
                });
            }

            function updateVariation(variationId, price, stock) {
                fetch('/Products/UpdateVariation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        variationId: parseInt(variationId),
                        price: parseFloat(price),
                        stock: parseInt(stock)
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Cập nhật thành công!');
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra!');
                });
            }

            function deleteVariation(variationId) {
                fetch(`/Products/DeleteVariation?variationId=${variationId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Xóa thành công!');
                        loadProductVariations();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra!');
                });
            }
        });
    </script>
}

