            padding: 8px 12px;
            font-size: 14px;
        }

        /* Shopee-like chips */
        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 8px;
        }
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            background: rgba(0, 102, 204, 0.08);
            border: 1px solid rgba(0, 102, 204, 0.22);
            color: #1e88e5;
            border-radius: 999px;
            font-size: 0.9rem;
        }
        .chip-remove {
            background: transparent;
            border: none;
