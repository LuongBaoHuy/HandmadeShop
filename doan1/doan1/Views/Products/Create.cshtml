            color: var(--text-primary);
            font-weight: 500;
        }
        .bulk-group .glass-input {
            width: 160px;
        }
        .stats {
            color: var(--text-secondary);
        }

        /* Grid preview nhiều ảnh */
        .upload-preview-grid {
            margin-top: 14px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 12px;
        }
        .preview-item {
