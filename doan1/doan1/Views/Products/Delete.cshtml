@model doan1.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="products-container">
    <div class="page-header">
        <div class="header-content danger">
            <div class="header-title">
                <div class="title-icon danger">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h1>Xóa sản phẩm</h1>
                <p>Xác nhận xóa sản phẩm "@Model.Name" khỏi hệ thống</p>
            </div>
        </div>
    </div>

    <!-- Flash messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- ModelState errors (fallback nếu TempData bị mất) -->
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    
    <div class="delete-container">
        <div class="glass-card warning-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-exclamation-triangle"></i>
                    Cảnh báo quan trọng
                </h3>
            </div>
            <div class="card-body">
                <div class="warning-content">
                    <div class="warning-icon">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <div class="warning-text">
                        <h4>Hành động này không thể hoàn tác!</h4>
                        <p>Bạn có chắc chắn muốn xóa sản phẩm này không? Tất cả dữ liệu liên quan sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>
                        <ul class="warning-list">
                            <li>Thông tin sản phẩm sẽ bị xóa hoàn toàn</li>
                            <li>Lịch sử bán hàng có thể bị ảnh hưởng</li>
                            <li>Dữ liệu này không thể khôi phục</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card product-summary-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-info-circle"></i>
                    Thông tin sản phẩm sẽ xóa
                </h3>
            </div>
            <div class="card-body">
                <div class="product-preview">
                    <div class="product-image">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="/HandmadeShopUploads/products/@Model.ImageUrl" alt="@Model.Name" style="max-width: 120px; max-height: 120px; object-fit: cover; border-radius: 10px;" />
                            }
                            else
                            {
                                <div class="image-placeholder"><i class="fa fa-image"></i> No Image</div>
                            }
                    </div>
                    <div class="product-info">
                        <h4>@Model.Name</h4>
                        <div class="product-details-grid">
                            <div class="detail-item">
                                <span class="label">Mã sản phẩm:</span>
                                <span class="value">#@Model.Id</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Danh mục:</span>
                                <span class="value">
                                    @if (Model.Category != null)
                                    {
                                        <span class="category-badge">@Model.Category.CategoriesName</span>
                                    }
                                    else
                                    {
                                        <span class="no-category">Chưa phân loại</span>
                                    }
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Giá bán:</span>
                                <span class="value">
                                    @if (Model.Price.HasValue)
                                    {
                                        <span class="price">@Model.Price.Value.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</span>
                                    }
                                    else
                                    {
                                        <span class="no-price">Chưa có giá</span>
                                    }
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Tồn kho:</span>
                                <span class="value">
                                    @if (Model.Stock.HasValue)
                                    {
                                        @if (Model.Stock.Value > 0)
                                        {
                                            <span class="stock-badge available">@Model.Stock.Value sản phẩm</span>
                                        }
                                        else
                                        {
                                            <span class="stock-badge out">Hết hàng</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="stock-badge unknown">Chưa cập nhật</span>
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <div class="detail-item full-width">
                                    <span class="label">Mô tả:</span>
                                    <span class="value description">@Model.Description</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card confirmation-card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-shield-alt"></i>
                    Xác nhận hành động
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Delete" method="post" class="delete-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="confirmation-section">
                        <div class="confirmation-checkbox">
                            <input type="checkbox" id="confirmDelete" required>
                            <label for="confirmDelete">
                                Tôi hiểu rằng hành động này không thể hoàn tác và đồng ý xóa sản phẩm này.
                            </label>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <a asp-action="Index" class="glass-btn secondary large">
                            <i class="fas fa-arrow-left"></i>
                            <span>Hủy bỏ</span>
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="glass-btn info large">
                            <i class="fas fa-eye"></i>
                            <span>Xem chi tiết</span>
                        </a>
                        <button type="submit" class="glass-btn danger large" id="deleteButton" disabled>
                            <i class="fas fa-trash"></i>
                            <span>Xóa sản phẩm</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Import Google Fonts */
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        :root {
            --primary-blue: #0066cc;
            --secondary-blue: #4da6ff;
            --light-blue: #e6f3ff;
            --dark-blue: #004499;
            --ocean-blue: #1e88e5;
            --sky-blue: #42a5f5;
            
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --medium-gray: #e9ecef;
            --dark-gray: #495057;
            --text-primary: #2c3e50;
            --text-secondary: #6c757d;
            
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            
            --shadow-light: 0 8px 32px rgba(31, 38, 135, 0.1);
            --shadow-medium: 0 12px 40px rgba(31, 38, 135, 0.15);
            --shadow-strong: 0 16px 48px rgba(31, 38, 135, 0.2);
            --shadow-neumorphism: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;
            
            --gradient-primary: linear-gradient(135deg, var(--primary-blue) 0%, var(--ocean-blue) 100%);
            --gradient-secondary: linear-gradient(135deg, var(--secondary-blue) 0%, var(--sky-blue) 100%);
            --gradient-light: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
            --gradient-danger: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            --gradient-warning: linear-gradient(135deg, var(--warning) 0%, #d97706 100%);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            color: var(--text-primary);
        }

        .products-container {
            padding: 2rem 1rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 3rem;
        }

        .header-content {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: var(--shadow-neumorphism);
            border: 1px solid rgba(255, 255, 255, 0.3);
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        .header-content.danger::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-danger);
            opacity: 0.1;
            border-radius: 30px;
        }

        .header-title {
            position: relative;
            z-index: 1;
        }

        .title-icon {
            width: 80px;
            height: 80px;
            background: var(--gradient-primary);
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: var(--shadow-medium);
        }

        .title-icon.danger {
            background: var(--gradient-danger);
        }

        .title-icon i {
            font-size: 2.5rem;
            color: white;
        }

        .header-title h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: var(--gradient-danger);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-title p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            margin: 0;
            font-weight: 400;
        }

        .delete-container {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            box-shadow: var(--shadow-neumorphism);
            border: 1px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-strong);
        }

        .glass-card .card-header {
            padding: 1.5rem 2rem;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }

        .glass-card .card-header h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-primary);
        }

        .glass-card .card-header i {
            color: var(--primary-blue);
            font-size: 1.3rem;
        }

        .warning-card .card-header i {
            color: var(--warning);
        }

        .glass-card .card-body {
            padding: 2rem;
        }

        .warning-content {
            display: flex;
            gap: 2rem;
            align-items: flex-start;
        }

        .warning-icon {
            width: 80px;
            height: 80px;
            background: var(--gradient-warning);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: var(--shadow-medium);
        }

        .warning-icon i {
            font-size: 2.5rem;
            color: white;
        }

        .warning-text h4 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--danger);
            margin-bottom: 1rem;
        }

        .warning-text p {
            font-size: 1.1rem;
            color: var(--text-primary);
            margin-bottom: 1.5rem;
            line-height: 1.6;
        }

        .warning-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .warning-list li {
            background: rgba(239, 68, 68, 0.1);
            border-left: 4px solid var(--danger);
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 0 8px 8px 0;
            color: var(--text-primary);
        }

        .warning-list li::before {
            content: '⚠️';
            margin-right: 0.5rem;
        }

        .product-preview {
            display: flex;
            gap: 2rem;
            align-items: flex-start;
        }

        .product-image {
            width: 200px;
            height: 200px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: var(--shadow-medium);
            flex-shrink: 0;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .image-placeholder {
            width: 100%;
            height: 100%;
            background: var(--gradient-secondary);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.9rem;
        }

        .image-placeholder i {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .product-info {
            flex: 1;
        }

        .product-info h4 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--text-primary);
        }

        .product-details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .detail-item {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .detail-item.full-width {
            grid-column: 1 / -1;
        }

        .detail-item .label {
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 0.9rem;
            display: block;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-item .value {
            font-weight: 500;
            color: var(--text-primary);
            font-size: 1rem;
        }

        .category-badge {
            background: var(--gradient-secondary);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .price {
            color: var(--success);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .stock-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 500;
            color: white;
        }

        .stock-badge.available {
            background: linear-gradient(135deg, var(--success) 0%, #34d399 100%);
        }

        .stock-badge.out {
            background: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
        }

        .stock-badge.unknown {
            background: linear-gradient(135deg, var(--text-secondary) 0%, #6b7280 100%);
        }

        .description {
            font-style: italic;
            line-height: 1.6;
        }

        .confirmation-section {
            margin-bottom: 2rem;
        }

        .confirmation-checkbox {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .confirmation-checkbox input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: var(--danger);
            margin: 0;
            flex-shrink: 0;
        }

        .confirmation-checkbox label {
            font-size: 1rem;
            color: var(--text-primary);
            line-height: 1.5;
            cursor: pointer;
            margin: 0;
        }

        .action-buttons {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .glass-btn {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            padding: 1rem 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow-light);
            position: relative;
            z-index: 1;
            overflow: hidden;
            justify-content: center;
            cursor: pointer;
        }

        .glass-btn.large {
            padding: 1.25rem 1.5rem;
            font-size: 1rem;
        }

        .glass-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-light);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }

        .glass-btn:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: var(--shadow-medium);
            text-decoration: none;
            color: var(--text-primary);
        }

        .glass-btn:hover:not(:disabled)::before {
            opacity: 1;
        }

        .glass-btn.secondary {
            background: rgba(108, 117, 125, 0.1);
            color: var(--text-secondary);
        }

        .glass-btn.info {
            background: linear-gradient(135deg, var(--info) 0%, #2563eb 100%);
            color: white;
        }

        .glass-btn.info::before {
            background: linear-gradient(135deg, #60a5fa 0%, var(--info) 100%);
        }

        .glass-btn.danger {
            background: linear-gradient(135deg, var(--danger) 0%, #dc2626 100%);
            color: white;
        }

        .glass-btn.danger::before {
            background: linear-gradient(135deg, #f87171 0%, var(--danger) 100%);
        }

        .glass-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 10px;
            margin: 0 0 16px 0;
            border: 1px solid transparent;
        }
        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            border-color: #ef4444;
            color: #991b1b;
        }
        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            border-color: #10b981;
            color: #065f46;
        }

        @@media (max-width: 768px) {
            .products-container {
                padding: 1rem 0.5rem;
            }

            .header-content {
                padding: 2rem;
            }

            .header-title h1 {
                font-size: 2rem;
            }

            .warning-content {
                flex-direction: column;
                text-align: center;
            }

            .product-preview {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .product-image {
                width: 150px;
                height: 150px;
            }

            .product-details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const confirmCheckbox = document.getElementById('confirmDelete');
            const deleteButton = document.getElementById('deleteButton');

            confirmCheckbox.addEventListener('change', function() {
                deleteButton.disabled = !this.checked;
            });

            // Add warning when user tries to delete
            deleteButton.addEventListener('click', function(e) {
                if (!confirmCheckbox.checked) {
                    e.preventDefault();
                    return;
                }

                const confirmed = confirm('Bạn có THỰC SỰ muốn xóa sản phẩm này? Hành động này không thể hoàn tác!');
                if (!confirmed) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
