@model doan1.Models.Product

@{
    ViewData["Title"] = "Thêm biến thể cho sản phẩm";
}

<div class="products-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="fas fa-cubes"></i>
                </div>
                <h1>Thêm biến thể cho sản phẩm</h1>
                <p>Bước 2: Chọn thuộc tính và tạo biến thể cho sản phẩm <b>@Model.Name</b></p>
            </div>
        </div>
    </div>

    <div class="create-container">
        <form asp-action="AddVariants" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="glass-card">
                <div class="card-header">
                    <h3><i class="fas fa-palette"></i> Chọn thuộc tính và giá trị</h3>
                </div>
                <div class="card-body">
                    <div id="attributesArea">
                        <!-- Giao diện chọn thuộc tính và giá trị sẽ render ở đây bằng JS hoặc partial view -->
                        <p>Bạn có thể chọn các thuộc tính (màu sắc, kích thước, ...) và giá trị để sinh biến thể. Nếu không muốn thêm biến thể, hãy bấm "Bỏ qua".</p>
                    </div>
                </div>
            </div>
            <div class="glass-card">
                <div class="card-header">
                    <h3><i class="fas fa-cubes"></i> Danh sách biến thể</h3>
                </div>
                <div class="card-body">
                    <div id="variantTableArea">
                        <!-- Bảng nhập giá/tồn kho cho từng biến thể sẽ render ở đây bằng JS hoặc partial view -->
                    </div>
                </div>
            </div>
            <div class="glass-card actions-card">
                <div class="card-body">
                    <div class="action-buttons">
                        <a asp-action="Index" class="glass-btn secondary large">
                            <i class="fas fa-arrow-left"></i>
                            <span>Quay lại danh sách</span>
                        </a>
                        <button type="submit" class="glass-btn primary large">
                            <i class="fas fa-save"></i>
                            <span>Lưu biến thể</span>
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="glass-btn large">
                            <i class="fas fa-forward"></i>
                            <span>Bỏ qua (không thêm biến thể)</span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // TODO: Thêm JS để render thuộc tính, sinh biến thể, nhập giá/tồn kho cho từng biến thể
        // Có thể dùng AJAX để lấy thuộc tính/options từ server nếu cần
    </script>
}
