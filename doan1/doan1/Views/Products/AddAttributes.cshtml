@model doan1.Models.ProductAttributeDetailViewModel
@{
    ViewData["Title"] = "Thêm thuộc tính cho sản phẩm";
}
<div class="products-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="fas fa-sliders-h"></i>
                </div>
                <h1>Thêm thuộc tính cho sản phẩm</h1>
                <p>Bước 2: Gán thuộc tính cho sản phẩm <b>@Model.ProductName</b> (ID: @Model.ProductId)</p>
            </div>
        </div>
    </div>
    <div class="glass-card">
        <div class="card-header">
            <h3><i class="fas fa-cogs"></i> Thuộc tính sản phẩm</h3>
        </div>
        <div class="card-body">
            <form asp-action="AddAttributes" method="post">
                <input type="hidden" name="ProductId" value="@Model.ProductId" />
                <div id="attributesArea">
                    <!-- Render existing attributes/options here -->
                    @if (Model.Attributes != null && Model.Attributes.Any())
                    {
                        foreach (var attr in Model.Attributes)
                        {
                            <div class="form-group">
                                <label><b>@attr.Name</b></label>
                                <div>
                                    @foreach (var opt in attr.Options)
                                    {
                                        <span class="badge badge-info" style="margin-right:8px;">@opt.Value</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <hr />
                <div class="form-group">
                    <label>Thêm thuộc tính mới</label>
                    <input type="text" class="glass-input" name="NewAttributeName" placeholder="Tên thuộc tính (vd: Màu sắc)" />
                </div>
                <div class="form-group">
                    <label>Giá trị thuộc tính (cách nhau bởi dấu phẩy)</label>
                    <input type="text" class="glass-input" name="NewAttributeOptions" placeholder="Đỏ, Xanh, Vàng" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="glass-btn primary"><i class="fas fa-plus"></i> Thêm thuộc tính</button>
                    <a asp-action="Index" class="glass-btn secondary">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>
