@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var email = ViewBag.Email as string ?? "";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root {
  --bg:#f5f7fb; --card:#ffffff; --text:#1f2937; --muted:#6b7280;
  --primary:#7c3aed; --primary-600:#6d28d9; --border:#e5e7eb;
  --danger:#ef4444; --success:#16a34a; --shadow:0 10px 25px rgba(0,0,0,.08);
}
*{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0; color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans";
  background: radial-gradient(1200px 800px at 90% -10%, #ede9fe, rgba(0,0,0,0) 60%), var(--bg);
}
.container{ max-width:560px; margin:60px auto; padding:0 16px; }

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:14px;
  box-shadow:var(--shadow);
  padding:22px;
}

.header{ display:flex; align-items:center; gap:12px; margin-bottom:6px; }
.header .logo{
  width:36px; height:36px; border-radius:8px; display:grid; place-items:center;
  background:linear-gradient(135deg,#a855f7,#ec4899); color:#fff;
}
.header h3{ margin:0; font-size:20px; font-weight:700; letter-spacing:.2px; }
.subtitle{ color:var(--muted); margin:6px 0 16px; }

.input-field{
  position:relative; display:flex; align-items:center;
  border:1px solid var(--border); border-radius:10px; background:#fff;
  padding:10px 12px; transition:border-color .2s, box-shadow .2s;
}
.input-field + .input-field{ margin-top:12px; }
.input-field:focus-within{ border-color:#c4b5fd; box-shadow:0 0 0 4px rgba(124,58,237,.12); }
.input-field i{ color:#9ca3af; margin-right:10px; font-size:16px; width:18px; text-align:center; }
.input-field input{ border:none; outline:none; width:100%; font-size:14px; background:transparent; color:var(--text); }

.btn{
  appearance:none; border:1px solid transparent; border-radius:10px;
  padding:12px 14px; font-weight:700; cursor:pointer; text-decoration:none;
  transition:background-color .2s, transform .02s, box-shadow .2s;
  box-shadow:0 2px 0 rgba(0,0,0,.05); display:inline-flex; align-items:center; justify-content:center;
}
.btn:active{ transform:translateY(1px); box-shadow:none; }
.btn.solid{ width:100%; background:var(--primary); color:#fff; }
.btn.solid:hover{ background:var(--primary-600); }

.alert{
  margin-top:10px; padding:10px 12px; border-radius:10px;
  background:#fff; border:1px solid var(--border); font-size:14px;
}
.alert-danger{ color:var(--danger); border-color:#fecaca; background:#fff7f7; }
.alert-success{ color:var(--success); border-color:#bbf7d0; background:#f0fdf4; }

.small-note{ margin-top:10px; text-align:center; color:var(--muted); font-size:12px; }

media (max-width:400px){
  .card{ padding:16px; }
}
</style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <div class="logo"><i class="fas fa-lock"></i></div>
        <h3>Đặt lại mật khẩu</h3>
      </div>

      <div class="subtitle">
        Mã OTP đã được gửi tới email: <strong>@email</strong>
      </div>

      <form asp-action="ResetPassword" asp-controller="User" method="post">
        <input type="hidden" name="email" value="@email" />

        <div class="input-field">
          <i class="fas fa-key"></i>
          <input type="text" name="code" placeholder="Nhập mã OTP (6 số)" maxlength="6" required />
        </div>

        <div class="input-field">
          <i class="fas fa-lock"></i>
          <input type="password" name="password" placeholder="Mật khẩu mới" required />
        </div>

        <div class="input-field">
          <i class="fas fa-lock"></i>
          <input type="password" name="confirmPassword" placeholder="Xác nhận mật khẩu mới" required />
        </div>

        @if (TempData["Message"] != null)
        {
            var ok = (TempData["MessageType"]?.ToString()=="success");
            <div class="alert @(ok ? "alert-success" : "alert-danger")">
                @TempData["Message"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="alert alert-danger">@err.ErrorMessage</div>
            }
        }

        <button type="submit" class="btn solid" style="background: #FFCC00;">Đổi mật khẩu</button>
        <div class="small-note">
          <a asp-action="ForgotPassword" asp-controller="User">Gửi lại OTP</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>