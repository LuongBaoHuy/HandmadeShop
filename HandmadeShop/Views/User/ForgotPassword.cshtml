@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root {
  --bg:#f5f7fb; --card:#ffffff; --text:#1f2937; --muted:#6b7280;
  --primary:#7c3aed; --primary-600:#6d28d9; --border:#e5e7eb;
  --danger:#ef4444; --success:#16a34a; --shadow:0 10px 25px rgba(0,0,0,.08);
}
*{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0; color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans";
  background: radial-gradient(1200px 800px at 90% -10%, #ede9fe, rgba(0,0,0,0) 60%), var(--bg);
}
.container{ max-width:560px; margin:60px auto; padding:120px 16px; }

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:14px;
  box-shadow:var(--shadow);
  padding:22px;
}

.header{ display:flex; align-items:center; gap:12px; margin-bottom:6px; }
.header .logo{
  width:36px; height:36px; border-radius:8px; display:grid; place-items:center;
  background:linear-gradient(135deg,#a855f7,#ec4899); color:#fff;
}
.header h2{ margin:0; font-size:20px; font-weight:700; letter-spacing:.2px; }
.subtitle{ color:var(--muted); margin:6px 0 16px; }

.input-field{
  position:relative; display:flex; align-items:center;
  border:1px solid var(--border); border-radius:10px; background:#fff;
  padding:10px 12px; transition:border-color .2s, box-shadow .2s;
}
.input-field + .input-field{ margin-top:12px; }
.input-field:focus-within{ border-color:#c4b5fd; box-shadow:0 0 0 4px rgba(124,58,237,.12); }
.input-field i{ color:#9ca3af; margin-right:10px; font-size:16px; width:18px; text-align:center; }
.input-field input{ border:none; outline:none; width:100%; font-size:14px; background:transparent; color:var(--text); }

.btn{
  appearance:none; border:1px solid transparent; border-radius:10px;
  padding:12px 14px; font-weight:700; cursor:pointer; text-decoration:none;
  transition:background-color .2s, transform .02s, box-shadow .2s;
  box-shadow:0 2px 0 rgba(0,0,0,.05); display:inline-flex; align-items:center; justify-content:center;
}
.btn:active{ transform:translateY(1px); box-shadow:none; }
.btn-primary{ width:100%; background:var(--primary); color:#fff; }
.btn-primary:hover{ background:var(--primary-600); }

.alert{
  margin-top:10px; padding:10px 12px; border-radius:10px;
  background:#fff; border:1px solid var(--border); font-size:14px;
}
.alert-danger{ color:var(--danger); border-color:#fecaca; background:#fff7f7; }
.alert-success{ color:var(--success); border-color:#bbf7d0; background:#f0fdf4; }

.helper{ margin-top:8px; color:var(--muted); font-size:12px; text-align:center; }

.field-error{ border-color:#ef4444 !important; box-shadow:0 0 0 4px rgba(239,68,68,.12) !important; }
.hidden{ display:none !important; }
media (max-width:400px){ .card{ padding:16px; } }
</style>

<div class="container" >
  <div class="card">
    <div class="header">
      <div class="logo"><i class="fa-solid fa-key"></i></div>
      <h2>Quên mật khẩu</h2>
    </div>
    <div class="subtitle">Nhập email đã đăng ký để nhận mã OTP đặt lại mật khẩu.</div>

    <form id="forgot-form" asp-action="ForgotPassword" asp-controller="User" method="post" novalidate>
      <div class="input-field" id="email-field">
        <i class="fas fa-envelope"></i>
        <input id="email" type="email" name="email" placeholder="Email" autocomplete="email" required />
      </div>
      <div id="email-error" class="alert alert-danger hidden"></div>

      @if (TempData["Message"] != null)
      {
          var ok = (TempData["MessageType"]?.ToString() == "success");
          <div class="alert @(ok ? "alert-success" : "alert-danger")">
              @TempData["Message"]
          </div>
      }

      @if (!ViewData.ModelState.IsValid)
      {
          foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
          {
              <div class="alert alert-danger">@err.ErrorMessage</div>
          }
      }

      <button type="submit" class="btn btn-primary" style="background: #FFCC00;">Gửi OTP</button>
      <div class="helper">Kiểm tra hộp thư đến hoặc thư mục Spam sau khi gửi yêu cầu.</div>
    </form>
  </div>
</div>

<script>
(function(){
  const form = document.getElementById('forgot-form');
  const input = document.getElementById('email');
  const field = document.getElementById('email-field');
  const errorBox = document.getElementById('email-error');

  function validateEmail(value){
    const email = (value || '').trim();
    if(!email) return 'Vui lòng nhập email.';
    const re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/i; 
    if(!re.test(email)) return 'Email không hợp lệ. Vui lòng kiểm tra lại.';
    return '';
  }
  function showError(msg){
    if(msg){
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
      field.classList.add('field-error');
    }else{
      errorBox.textContent = '';
      errorBox.classList.add('hidden');
      field.classList.remove('field-error');
    }
  }

  input.addEventListener('blur', () => showError(validateEmail(input.value)));
  input.addEventListener('input', () => { if(!validateEmail(input.value)) showError(''); });

  form.addEventListener('submit', (e) => {
    const msg = validateEmail(input.value);
    if(msg){ e.preventDefault(); showError(msg); input.focus(); }
    else { input.value = input.value.trim(); showError(''); }
  });
})();
</script>