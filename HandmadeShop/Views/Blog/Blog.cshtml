    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="body-content">
    <div class="container">
        <div class="row">
            <div class="blog-page">
                <div class="col-md">
                    <div class="blog-post wow fadeInUp">
                        <a href="#"><img class="img-responsive" src="~/images/blog-post/blog_big_01.jpg" alt="Bí quyết chọn quà handmade"></a>
                        <h1><a href="#">Bí quyết chọn quà handmade ý nghĩa cho người thân</a></h1>
                        <span class="author">HandmadeShop</span>
                        <span class="review">12 Bình luận</span>
                        <span class="date-time">06/08/2025 09:00AM</span>
                        <p>
                            Quà tặng handmade luôn mang lại cảm xúc đặc biệt bởi sự tỉ mỉ và tâm huyết của người làm ra. Hãy cùng chúng tôi khám phá những bí quyết chọn quà handmade phù hợp với từng dịp lễ, giúp bạn gửi gắm yêu thương đến người thân, bạn bè một cách trọn vẹn nhất!
                        </p>
                    </div>
